RemoveDatastoreScreen {
    align: center middle;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

#button_ok {
    width: 30;
}
#button_cancel {
    width: 30;
}

.button {
    border: heavy $panel;
    margin: 2 4;
}

DataTable {
    background: rgb(100, 100, 100);
}

#input_name {
    width: 30;
    border: heavy $panel;
}

LoadingIndicator {
    width: 20;
    height: 3;
    min-height: 1;
    color: $primary;
    text-style: not reverse;
}
