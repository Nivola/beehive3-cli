msgstr "nome del volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:692
msgid "volume availability_zone"
msgstr "availability zone del volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:697
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:7095
#: ../beehive3_cli/plugins/vsphere/controllers/resource.py:2169
msgid "volume type"
msgstr "tipo di volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:698
#: ../beehive3_cli/plugins/provider/controllers/resource.py:5488
#: ../beehive3_cli/plugins/vsphere/controllers/resource.py:1641
#: ../beehive3_cli/plugins/vsphere/controllers/resource.py:2166
msgid "volume size"
msgstr "dimensione del volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:702
msgid "volume iops"
msgstr "iops del volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:711
msgid "volume hypervisor. Can be: openstack or vsphere [default=vsphere]"
msgstr ""
"hypervisor del volume. Può essere: Openstack o vSphere [default=vsphere]"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:747
msgid "delete a volume"
msgstr "elimina un volume"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:748
msgid ""
"This command deletes a volume by specifying its id. The volume id is a "
"required argument for this command to identify the volume to be deleted. An "
"optional -y flag can also be provided to skip confirmation prompt for "
"deleting the volume."
msgstr ""
"Questo comando elimina un volume specificandone l'ID. L'ID del volume è un "
"argomento obbligatorio per questo comando per identificare il volume da "
"eliminare. Può anche essere fornito un flag opzionale -y per saltare la "
"richiesta di conferma per l'eliminazione del volume."

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:773
