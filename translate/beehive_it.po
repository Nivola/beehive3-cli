#: ../beehive3_cli/plugins/business/controllers/authority/division.py:164
msgid "add division"
msgstr "aggiungi divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:165
msgid ""
"This command adds a new division to an organization. It requires the "
"division name and organization UUID as arguments. The division name is used "
"to identify the division being added and the organization UUID specifies "
"which organization this new division will belong to."
msgstr ""
"Questo comando aggiunge una nuova divisione a un'organizzazione. Richiede il "
"nome della divisione e l'UUID dell'organizzazione come argomenti. Il nome "
"della divisione viene utilizzato per identificare la divisione che viene "
"aggiunta e l'UUID dell'organizzazione specifica a quale organizzazione "
"apparterrà questa nuova divisione."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:177
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:254
msgid "division description"
msgstr "descrizione della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:208
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:290
msgid "division postaladdress"
msgstr "indirizzo della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:217
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:299
msgid "division price list id"
msgstr "id del listino prezzi della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:243
msgid "update division"
msgstr "aggiorna divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:244
msgid ""
"This command updates an existing division in Nivola CMP. The division name "
"argument is required to identify which division to update."
msgstr ""
"Questo comando aggiorna una divisione esistente in Nivola CMP. L'argomento "
"del nome della divisione è necessario per identificare quale divisione "
"aggiornare."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:318
msgid "refresh division"
msgstr "aggiorna divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:319
msgid ""
"This command refreshes a division by its unique ID. The ID argument is "
"required to identify which division to refresh. Refreshing a division "
"updates it with any changes from the server."
msgstr ""
"Questo comando aggiorna una divisione tramite il suo ID univoco. L'argomento "
"ID è obbligatorio per identificare quale divisione aggiornare. "
"L'aggiornamento di una divisione la sincronizza con eventuali modifiche dal "
"server."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:338
msgid "delete division"
msgstr "elimina divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:339
msgid ""
"This command deletes a division from the Nivola CMP platform by its unique "
"ID. The ID of the division to delete must be provided as the only required "
"argument."
msgstr ""
"Questo comando elimina una divisione dalla piattaforma Nivola CMP tramite il "
"suo ID univoco. L'ID della divisione da eliminare deve essere fornito come "
"unico argomento obbligatorio."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:360
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:361
msgid "division authorization"
msgstr "autorizzazione della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:364
msgid "get division roles"
msgstr "ottieni ruoli di divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:365
msgid ""
"This command retrieves the roles associated with a specific division. The "
"division is identified by its UUID which must be provided using the 'id' "
"argument. The roles are returned for authorization on the specified division."
msgstr ""
"Questo comando recupera i ruoli associati a una divisione specifica. La "
"divisione è identificata dal suo UUID che deve essere fornita utilizzando "
"l'argomento \"ID\". I ruoli vengono restituiti per l'autorizzazione nella "
"divisione specificata."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:383
msgid "get division users"
msgstr "ottieni utenti della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:384
msgid ""
"This command retrieves user details for a specific division. The division "
"uuid must be provided using the required 'id' argument."
msgstr ""
"Questo comando recupera i dettagli dell'utente per una divisione specifica. "
"Lo UUID della divisione deve essere fornita utilizzando l'argomento \"ID\" "
"richiesto."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:407
msgid "add division role to a user"
msgstr "aggiungi il ruolo di divisione a un utente"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:408
msgid ""
"This command adds a division role to a user. It requires the division UUID, "
"the role to assign within that division, and the user to assign the role to "
"as required arguments."
msgstr ""
"Questo comando aggiunge un ruolo di divisione a un utente. Richiede la "
"divisione UUID, il ruolo da assegnare all'interno di quella divisione e "
"l'utente di assegnare il ruolo agli argomenti richiesti."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:416
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:443
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:495
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:522
msgid "division role"
msgstr "ruolo della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:434
msgid "remove division role from a user"
msgstr "rimuovi il ruolo di divisione da un utente"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:435
msgid ""
"This command removes a division role from a specific user. It requires the "
"division UUID, the role within that division (such as 'admin' or 'member'), "
"and the username to remove the role from."
msgstr ""
"Questo comando rimuove un ruolo di divisione da un utente specifico. "
"Richiede lo UUID di divisione, il ruolo all'interno di quella divisione "
"(come 'admin' o 'member') e il nome utente per rimuovere il ruolo."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:461
msgid "get division groups"
msgstr "ottieni gruppi di divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:462
msgid ""
"This command retrieves the groups associated with a specific division. The "
"division is identified by its UUID which must be provided with the 'id' "
"argument. This allows retrieving all the groups that have access to the "
"specified division for authorization purposes."
msgstr ""
"Questo comando recupera i gruppi associati a una divisione specifica. La "
"divisione è identificata dal suo UUID che deve essere fornito con "
"l'argomento \"ID\". Ciò consente di recuperare tutti i gruppi che hanno "
"accesso alla divisione specificata a fini di autorizzazione."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:487
msgid "add division role to a group"
msgstr "aggiungi il ruolo di divisione a un gruppo"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:488
msgid ""
"This command adds an authorization group to a division role. It requires the "
"division UUID, role and group name as arguments."
msgstr ""
"Questo comando aggiunge un gruppo di autorizzazione a un ruolo di divisione. "
"Richiede lo UUID di divisione, il ruolo e il nome del gruppo come argomenti."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:513
msgid "remove division role from a group"
msgstr "rimuovi il ruolo di divisione da un gruppo"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:514
msgid ""
"This command removes a division role from an authorization group. It "
"requires the division UUID, role and group name as arguments to identify "
"which specific division role assignment to remove from the group."
msgstr ""
"Questo comando rimuove un ruolo di divisione da un gruppo di autorizzazione. "
"Richiede lo UUID di divisione, il ruolo e il nome del gruppo come argomenti "
"per identificare quale specifica assegnazione del ruolo di divisione "
"rimuoverà dal gruppo."

#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:14
#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:15
msgid "organization management"
msgstr "gestione dell'organizzazione"

#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:30
msgid ""
"This command is used to retrieve organizations from the platform. It does "
"not require any arguments. The organizations returned can optionally be "
"filtered and paginated using optional arguments like -name, -size and -page."
msgstr ""
"Questo comando viene utilizzato per recuperare le organizzazioni dalla "
"piattaforma. Non richiede alcun argomento. Le organizzazioni restituite "
"possono facoltativamente essere filtrate e paginate usando argomenti "
"opzionali come -name, -ze e -page."

#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:69
#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:244
#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:366
