msgstr "tipo di organizzazione"

#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:78
#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:258
#: ../beehive3_cli/plugins/business/controllers/authority/organization.py:380
