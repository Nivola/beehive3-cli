#: ../beehive3_cli/plugins/business/controllers/staas.py:823
msgid "mount efs"
msgstr "monta efs"

#: ../beehive3_cli/plugins/business/controllers/staas.py:824
msgid "Mount efs"
msgstr "Monta efs"

#: ../beehive3_cli/plugins/business/controllers/staas.py:828
msgid "efs uuid"
msgstr "uuid di efs"

#: ../beehive3_cli/plugins/business/controllers/staas.py:841
msgid "list share mount target"
msgstr "elenco dei mount target delle share"

#: ../beehive3_cli/plugins/business/controllers/staas.py:842
msgid ""
"This command lists all the mount targets that are associated with the "
"specified EFS file system. An EFS mount target represents a gateway that "
"clients use to access an EFS file system. This command returns information "
"about each mount target such as the IP address and NFSv4 ID. The -size and --"
"notruncate options can be used to control the output."
msgstr ""
"Questo comando elenca tutti i mount target associati al file system EFS "
"specificato. Un mount target EFS rappresenta un gateway che i client "
"utilizzano per accedere a un file system EFS. Questo comando restituisce "
"informazioni su ogni mount target, come l'indirizzo IP e l'ID NFSv4. Le "
"opzioni -size e --notruncate possono essere utilizzate per controllare "
"l'output."

#: ../beehive3_cli/plugins/business/controllers/staas.py:940
msgid "create share mount target"
msgstr "crea uno share mount target"

#: ../beehive3_cli/plugins/business/controllers/staas.py:941
msgid ""
"This command creates a mount target for the specified EFS file system share. "
"A mount target represents an IP address within a specific Availability Zone "
"on which the file system may be mounted. It requires the share ID as the "
"first argument and optionally takes the subnet ID as the second argument and "
"environment as third argument."
msgstr ""
"Questo comando crea una mount target per lo share del file system EFS "
"specificato. Una destinazione di montaggio rappresenta un indirizzo IP "
"all'interno di una specifica Availability Zone su cui il file system può "
"essere montato. Richiede l'ID dello share come primo argomento e, "
"opzionalmente, accetta l'ID della subnet come secondo argomento e "
"l'environment come terzo argomento."

#: ../beehive3_cli/plugins/business/controllers/staas.py:955
msgid "share subnet"
msgstr "share subnet"

#: ../beehive3_cli/plugins/business/controllers/staas.py:964
msgid "protocol should be  nfs|cifs"
msgstr "il protocollo dovrebbe essere NFS | CIFS"

#: ../beehive3_cli/plugins/business/controllers/staas.py:973
#: ../beehive3_cli/plugins/provider/controllers/resource.py:6646
msgid "custom label to be used when you want to use a labelled share type"
msgstr ""
"etichetta personalizzata da utilizzare quando si desidera utilizzare un tipo "
"di share etichettato"

#: ../beehive3_cli/plugins/business/controllers/staas.py:982
msgid "ontap netapp volume id"
msgstr "id del volume ONTAP NetApp"

#: ../beehive3_cli/plugins/business/controllers/staas.py:1015
msgid "delete share mount target"
msgstr "elimina il mount target della share"

#: ../beehive3_cli/plugins/business/controllers/staas.py:1016
msgid ""
"This CLI command deletes a specific share mount target from the Nivola CMP "
"EFS service. It requires the share ID as the only required argument to "
"identify the target to delete."
msgstr ""
"Questo comando CLI elimina una specifica il mount target della share dal "
"servizio Nivola CMP EFS. Richiede l'ID della share come unico argomento "
"obbligatorio per identificare la destinazione da eliminare."

#: ../beehive3_cli/plugins/business/controllers/staas.py:1062
msgid "get share access grants"
msgstr "ottieni concessioni di accesso a uno share"

#: ../beehive3_cli/plugins/business/controllers/staas.py:1063
msgid "Get share grants."
msgstr "Ottieni concessioni allo share."

