msgstr "se False non mostra i dettagli (risorsa)"

#: ../beehive3_cli/plugins/business/controllers/service.py:1313
msgid "import service instance from resource"
msgstr "importa service instance da resource"

#: ../beehive3_cli/plugins/business/controllers/service.py:1314
msgid ""
"This command imports a service instance from a resource. It requires the "
"service instance name, account id, plugin type of the service instance and "
"plugin type of the container to be provided as required arguments."
msgstr ""
"Questo comando importa un'istanza di servizio da una risorsa. Richiede che "
"vengano forniti come argomenti obbligatori il nome dell'istanza di servizio, "
"l'ID dell'account, il tipo di Plugin dell'istanza di servizio e il tipo di "
"Plugin del container."

#: ../beehive3_cli/plugins/business/controllers/service.py:1324
#: ../beehive3_cli/plugins/business/controllers/service.py:1493
msgid "service instance name"
msgstr "nome dell'istanza di servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1329
msgid "service instance description"
msgstr "descrizione dell'istanza di servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1340
