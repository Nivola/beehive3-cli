#: ../beehive3_cli/plugins/business/controllers/service.py:1365
#: ../beehive3_cli/plugins/resource/controllers/entity.py:1169
#: ../beehive3_cli/plugins/ssh/controllers/operations.py:378
msgid "resource id"
msgstr "id della risorsa"

#: ../beehive3_cli/plugins/business/controllers/service.py:1374
msgid "parent service instance id"
msgstr "id di istanza del servizio genitore"

#: ../beehive3_cli/plugins/business/controllers/service.py:1424
msgid "check service instance"
msgstr "controlla l'istanza del servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1425
msgid ""
"This command checks the status of service instances running on Nivola Cloud. "
"It allows the user to verify if their services are running properly without "
"having to log into the platform directly. The command does not require any "
"arguments as it will check all service instances by default. The output "
"provides the name, status and other details of each service instance so the "
"user can easily monitor them."
msgstr ""
"Questo comando controlla lo stato delle istanze di servizio in esecuzione su "
"Nivola Cloud. Consente all'utente di verificare se i loro servizi sono in "
"esecuzione correttamente senza dover accedere direttamente alla piattaforma. "
"Il comando non richiede alcun argomento in quanto controllerà tutte le "
"istanze di servizio per impostazione predefinita. L'output fornisce il nome, "
"lo stato e altri dettagli di ciascuna istanza di servizio in modo che "
"l'utente possa facilmente monitorarli."

#: ../beehive3_cli/plugins/business/controllers/service.py:1454
msgid "update service instance"
msgstr "aggiorna l'istanza del servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1455
msgid ""
"This CLI command updates an existing service instance in Nivola Cloud. The "
"service instance is identified by its name or ID. No arguments are required "
"as the instance details will need to be provided via a configuration file or "
"interactive prompts."
msgstr ""
"Questo comando CLI aggiorna un'istanza di servizio esistente in Nivola "
"Cloud. L'istanza di servizio è identificata dal suo nome o ID. Non sono "
"richiesti argomenti poiché i dettagli dell'istanza dovranno essere forniti "
"tramite un file di configurazione o prompt interattivi."

#: ../beehive3_cli/plugins/business/controllers/service.py:1510
msgid "patch service instance"
msgstr "esegui patch sull'istanza di servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1511
msgid ""
"This CLI command patches or updates an existing service instance. Since "
"there are no required arguments listed, it likely accepts the service "
"instance ID or name as a parameter to identify which instance to update, "
"along with other optional arguments to specify which attributes or fields of "
"the instance should be modified."
msgstr ""
"Questo comando CLI aggiusta o aggiorna un'istanza di servizio esistente. "
"Poiché non sono elencati argomenti obbligatori, probabilmente accetta l'ID o "
"il nome dell'istanza di servizio come parametro per identificare quale "
"istanza aggiornare, insieme ad altri argomenti opzionali per specificare "
"quali attributi o campi dell'istanza devono essere modificati."

#: ../beehive3_cli/plugins/business/controllers/service.py:1540
#: ../beehive3_cli/plugins/business/controllers/service.py:1541
msgid "update service instance forcing his status to \"error\" or \"active\" "
msgstr ""
"aggiorna l'istanza del servizio costringendo il suo stato a \"error\" o "
"\"active\" "

#: ../beehive3_cli/plugins/business/controllers/service.py:1556
msgid "service instance status must be \"active\" or \"error\" "
msgstr "lo stato dell'istanza del servizio deve essere \"active\" o \"error\" "

#: ../beehive3_cli/plugins/business/controllers/service.py:1576
msgid "delete service instance"
msgstr "elimina l'istanza del servizio"

#: ../beehive3_cli/plugins/business/controllers/service.py:1577
msgid ""
"This command deletes a service instance. It requires the service instance ID "
"as a parameter to identify which instance to delete. The command also "
"supports optional flags to specify the environment (-e) of the instance and "
"assume yes (-y) without confirmation."
msgstr ""
"Questo comando elimina un'istanza di servizio. Richiede l'ID dell'istanza di "
"servizio come parametro per identificare quale istanza eliminare. Il comando "
"supporta anche flag opzionali per specificare l'ambiente (-e) dell'istanza e "
"confermare (-y) senza richiesta."

#: ../beehive3_cli/plugins/business/controllers/service.py:1599
msgid "do not propagate propagate delete to all cmp modules [default=true]"
msgstr "non propagare l'eliminazione su tutti i moduli CMP [default = true]"

#: ../beehive3_cli/plugins/business/controllers/service.py:1606
msgid "if True force delete [default=false]"
msgstr "se True forza l'eliminazione [default = false]"

#: ../beehive3_cli/plugins/business/controllers/service.py:1653
msgid ""
"This command allows adding one or more tags to a service instance. The tags "
"argument requires a comma separated list of tag names that will be added to "
"the specified service instance. Tags can be used to logically group and "
"filter service instances for management purposes."
msgstr ""
"Questo comando permette di aggiungere uno o più tag a un'istanza di "
"servizio. L'argomento tags richiede un elenco di nomi di tag, separati da "
"virgole, che verranno aggiunti all'istanza di servizio specificata. I tag "
"possono essere usati per raggruppare e filtrare logicamente le istanze di "
"servizio per scopi di gestione."

#: ../beehive3_cli/plugins/business/controllers/service.py:1673
#: ../beehive3_cli/plugins/business/controllers/service.py:1711
#: ../beehive3_cli/plugins/business/controllers/service.py:1752
#: ../beehive3_cli/plugins/openstack/controllers/resource.py:2231
msgid "comma separated list of tags"
msgstr "elenco di tag separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/service.py:1690
msgid "add tag to account's service instances"
msgstr "aggiungi tag alle istanze di servizio dell'account"

#: ../beehive3_cli/plugins/business/controllers/service.py:1691
msgid ""
"This command allows adding one or more tags to account's service instances. "
"The tags argument requires a comma separated list of tag names that will be "
"added to the specified service instance. Tags can be used to logically group "
"and filter service instances for management purposes."
msgstr ""
"Questo comando consente di aggiungere uno o più tag alle istanze di servizio "
"di un account. L'argomento tags richiede un elenco di nomi di tag, separati "
"da virgole, che verranno aggiunti all'istanza di servizio specificata. I tag "
"possono essere usati per raggruppare e filtrare logicamente le istanze di "
"servizio a scopi di gestione."

#: ../beehive3_cli/plugins/business/controllers/service.py:1733
msgid ""
"This command deletes one or more tags from a service instance. The tags "
"argument requires a comma separated list of tag names to remove from the "
"instance. This allows an operator to untag or remove labels from resources "
"in the platform."
msgstr ""
"Questo comando elimina uno o più tag da un'istanza di servizio. L'argomento "
"tags richiede un elenco di nomi di tag, separati da virgole, da rimuovere "
"dall'istanza. Ciò consente a un operatore di rimuovere tag o etichette dalle "
"risorse nella piattaforma."

