#: ../beehive3_cli/plugins/provider/controllers/resource.py:2515
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2731
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2760
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2789
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2881
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2983
msgid "vpc id"
msgstr "id del VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:278
msgid "add virtual private cloud"
msgstr "aggiungi cloud privato virtuale"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:279
msgid ""
"This command adds a new virtual private cloud (VPC) to the specified "
"account. It requires the VPC name, account ID and CIDR block as required "
"arguments. Optionally a template can also be provided to apply certain "
"configuration to the new VPC."
msgstr ""
"Questo comando aggiunge un nuovo cloud privato virtuale (VPC) all'account "
"specificato. Richiede il nome VPC, l'ID account e il blocco CIDR come "
"argomenti richiesti. Facoltativamente può anche essere fornito un template "
"per applicare una determinata configurazione al nuovo VPC."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:287
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2664
msgid "vpc name"
msgstr "nome del VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:291
msgid "vpc cidr block"
msgstr "blocco CIDR della VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:296
msgid "vpc template"
msgstr "template VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:305
msgid ""
"allowed tenancy of instances launched into the VPC. Use default for shared "
"vpc. Use dedicated for private vpc. default is dedicated"
msgstr ""
"tenancy consentita delle istanze avviate nella VPC. Usa default per VPC "
"condivise. Usa dedicated per VPC private. Il valore predefinito è dedicated"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:332
msgid "delete a vpc"
msgstr "elimina un VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:333
msgid ""
"This command deletes a VPC (Virtual Private Cloud) by specifying its ID. The "
"VPC ID is a required argument for this command to identify which VPC to "
"delete from the account."
msgstr ""
"Questo comando è usato per recuperare i template VPC da Nivola Cloud. I "
"template VPC definiscono configurazioni di rete che possono essere usate per "
"implementare rapidamente nuove VPC. Questo comando senza argomenti "
"restituirà tutti i template disponibili. Un template specifico può essere "
"recuperato fornendo il suo identificatore univoco come argomento."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:363
msgid "get vpc templates"
msgstr "ottieni template VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:364
msgid ""
"This command is used to retrieve VPC templates from Nivola Cloud. VPC "
"templates define network configurations that can be used to quickly deploy "
"new VPCs. This command with no arguments will return all available "
"templates. A specific template can be retrieved by providing its unique "
"identifier as an argument."
msgstr ""
"Questo comando è usato per recuperare i template VPC da Nivola Cloud. I "
"template VPC definiscono configurazioni di rete che possono essere usate per "
"implementare rapidamente nuove VPC. Questo comando senza argomenti "
"restituirà tutti i template disponibili. Un template specifico può essere "
"recuperato fornendo il suo identificatore univoco come argomento."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:404
#: ../beehive3_cli/plugins/business/controllers/netaas.py:405
msgid "vpc subnet service management"
msgstr "gestione dei servizi VPC subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:408
msgid "get vpc subnet"
msgstr "subnet del VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:409
msgid "This command is used to get the subnet by uuid"
msgstr "Questo comando serve per recuperare la subnet tramite uuid"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:415
#: ../beehive3_cli/plugins/business/controllers/netaas.py:626
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1550
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1735
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1778
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1930
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:2567
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:2623
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:4758
#: ../beehive3_cli/plugins/openstack/controllers/resource.py:633
#: ../beehive3_cli/plugins/openstack/controllers/resource.py:908
msgid "subnet id"
msgstr "id della subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:443
msgid "get vpc subnets"
msgstr "ottieni le  subnet VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:444
msgid ""
"This command is used to get the subnets under a VPC. It lists all the "
"subnets available in the given account. The account must be specified using "
"the -account flag with the account name or ID."
msgstr ""
"Questo comando è usato per ottenere le subnet sotto una VPC. Elenca tutte le "
"subnet disponibili nell'account specificato. L'account deve essere "
"specificato usando il flag -account con il nome o l'ID dell'account."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:465
msgid "list of subnet id comma separated"
msgstr "lista di id di subnet separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:474
#: ../beehive3_cli/plugins/business/controllers/netaas.py:796
msgid "list of vpc id comma separated"
msgstr "elenco di id di VPC separate da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:501
#: ../beehive3_cli/plugins/provider/controllers/resource.py:888
#: ../beehive3_cli/plugins/provider/controllers/resource.py:2574
msgid "show the allocation pools details"
msgstr "mostra i dettagli dei pool di allocazione"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:572
msgid "add virtual private cloud subnet"
msgstr "aggiungi subnet al Virtual Private Cloud"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:573
msgid ""
"This command adds a new subnet to an existing VPC. It requires the name of "
"the subnet, ID of the VPC it belongs to, the CIDR block of the subnet, and "
"the availability zone where it will be created."
msgstr ""
"Questo comando aggiunge una nuova sotto rete a un VPC esistente. Richiede il "
"nome della sotto rete, l'ID del VPC a cui appartiene, il blocco CIDR della "
"sotto rete e la zona di disponibilità in cui verrà creata."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:580
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1653
#: ../beehive3_cli/plugins/openstack/controllers/platform.py:1744
msgid "subnet name"
msgstr "nome della subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:584
msgid "subnet cidr block"
msgstr "blocco CIDR della subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:593
msgid "subnet template"
msgstr "template della subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:617
msgid "delete a subnet"
msgstr "elimina subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:618
msgid ""
"This command deletes a subnet from the Nivola CMP platform. The subnet id is "
"required as an argument to identify which subnet needs to be deleted from "
"the account. Once deleted, all resources associated with that subnet will be "
"removed permanently."
msgstr ""
"Questo comando elimina una subnet dalla piattaforma Nivola CMP. L'ID della "
"subnet è richiesto come argomento per identificare quale subnet deve essere "
"eliminata dall'account. Una volta eliminati, tutte le risorse associate a "
"quella subnet verranno rimosse permanentemente."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:648
msgid "get subnets templates"
msgstr "ottiene template delle subnet"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:649
msgid ""
"This command is used to retrieve subnet templates from Nivola Cloud. Subnet "
"templates define network configurations that can be applied when creating "
"new subnets in a business unit's virtual network. The command accepts an "
"optional business unit ID and template ID to filter the results."
msgstr ""
"Questo comando è usato per recuperare i template di subnet da Nivola Cloud. "
"I template di subnet definiscono configurazioni di rete che possono essere "
"applicate durante la creazione di nuove subnet nella rete virtuale di "
"un'unità di business. Il comando accetta un ID di unità di business e un ID "
"di template opzionali per filtrare i risultati."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:688
#: ../beehive3_cli/plugins/business/controllers/netaas.py:689
msgid "security groups service management"
msgstr "gestione dei servizi security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:692
msgid "get security group templates"
msgstr "ottieni template dei security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:693
msgid ""
"This command is used to retrieve security group templates from Nivola Cloud. "
"Security group templates define a set of rules that can be applied to "
"security groups to control ingress and egress network access. The templates "
"command with no additional arguments will return all available templates. A "
"template ID can also be provided to get details of a specific template."
msgstr ""
"Questo comando è usato per recuperare i template di security group da Nivola "
"Cloud. I template di security group definiscono un insieme di regole che "
"possono essere applicate ai security group per controllare l'accesso di rete "
"in ingress ed egress. Il comando 'templates' senza argomenti aggiuntivi "
"restituirà tutti i template disponibili. Un ID di template può anche essere "
"fornito per ottenere i dettagli di uno specifico template."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:728
msgid "create a security group"
msgstr "crea un security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:729
msgid ""
"This CLI command creates a security group with the specified name in the "
"given VPC. It requires the security group name, parent VPC and an optional "
"template ID as arguments."
msgstr ""
"Questo comando CLI crea un security group con il nome specificato nella VPC "
"indicata. Richiede il nome del security group, la VPC padre e un ID di "
"template opzionale come argomenti."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:741
#: ../beehive3_cli/plugins/provider/controllers/resource.py:3255
msgid "security group name"
msgstr "nome del security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:743
msgid "parent vpc"
msgstr "genitore del VPC"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:763
#: ../beehive3_cli/plugins/openstack/controllers/resource.py:710
#: ../beehive3_cli/plugins/openstack/controllers/resource.py:711
msgid "get security groups"
msgstr "ottieni security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:764
msgid ""
"This command is used to retrieve and display the list of security groups "
"associated with the current AWS account. Security groups act as a virtual "
"firewall that controls the traffic for instances. This allows you to specify "
"the protocols and ports that can reach your instances. By listing the "
"security groups, you can view the existing rules and configurations for "
"network access management."
msgstr ""
"Questo comando è usato per recuperare e visualizzare l'elenco dei security "
"group associati all'account   corrente. I security group agiscono come un "
"firewall virtuale che controlla il traffico per le istanze. Questo ti "
"permette di specificare i protocolli e le porte che possono raggiungere le "
"tue istanze. Elencando i security group, puoi visualizzare le regole e le "
"configurazioni esistenti per la gestione dell'accesso alla rete."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:787
msgid "list of security group id comma separated"
msgstr "id dei security group separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:920
msgid "get security group with rules"
msgstr "ottieni security group con le regole"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:921
msgid ""
"This command retrieves the security group details including its rules. The "
"security group id is required as an argument to fetch the specific security "
"group details."
msgstr ""
"Questo comando recupera i dettagli del security group, incluse le sue "
"regole. L'ID del security group è richiesto come argomento per recuperare i "
"dettagli specifici del security group."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:930
#: ../beehive3_cli/plugins/business/controllers/netaas.py:995
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1021
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1065
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1218
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:2368
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:2405
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:2474
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:2506
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:2539
msgid "securitygroup id"
msgstr "id del security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:983
msgid "patch a security group"
msgstr "esegui patch su security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:984
msgid ""
"This CLI command patches or updates an existing security group in Nivola "
"Cloud. It requires the security group ID as the only required argument to "
"identify which security group to update. This allows modifying attributes of "
"the security group like its name, description or rules."
msgstr ""
"Questo comando esegue una patch o aggiorna un security group esistente in "
"Nivola Cloud. Richiede l'ID del security group come unico argomento "
"obbligatorio per identificare quale security group aggiornare. Ciò consente "
"di modificare attributi del security group come il nome, la descrizione o le "
"regole."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1009
msgid "delete a security group"
msgstr "elimina security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1010
msgid ""
"This command deletes a security group. It requires the security group ID as "
"the only required argument. The -y flag confirms deletion and -e <env> "
"provides an environment name if multiple environments exist."
msgstr ""
"Questo comando elimina un security group. Richiede l'ID del security group "
"come unico argomento obbligatorio. Il flag -y conferma l'eliminazione e -e "
"<env> fornisce un nome di ambiente se esistono più ambienti."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1038
msgid "add a security group rule"
msgstr "aggiungi una regola al security group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1039
msgid ""
"This command allows you to add a new rule to an existing security group. You "
"need to specify whether it is an egress or ingress rule by providing the "
"'type' argument. For egress rules, you also need to specify the destination "
"using '-destination' flag and for ingress rules, you need to specify the "
"source using '-source' flag. The 'securitygroup' argument is used to specify "
"the security group id to which the rule needs to be added."
msgstr ""
"Questo comando consente di aggiungere una nuova regola a un security group "
"esistente. È necessario specificare se si tratta di una regola egress o "
"ingress fornendo l'argomento 'type'. Per le regole egress, è inoltre "
"necessario specificare la destinazione utilizzando il flag '-destination', "
"mentre per le regole ingress, è necessario specificare la sorgente "
"utilizzando il flag '-source'. L'argomento 'security group' viene utilizzato "
"per specificare l'ID del security group a cui la regola deve essere aggiunta."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1056
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1209
msgid ""
"egress or ingress. For egress rule the destination. For ingress rule specify "
"the source"
msgstr ""
"egress o ingress. Per la regola egress specificare la destinazione. Per la "
"regola ingress specificare l'origine"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1070
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1223
msgid "protocol. can be tcp, udp, icmp or -1 for all"
msgstr "protocollo. Può essere tcp, udp, icmp or -1 for"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1079
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1232
msgid ""
"can be an integer between 0 and 65535 or a range with start and end in the "
"same interval. Range format is <start>-<end>. Use -1 for all ports. Set "
"subprotocol if proto is icmp (8 for ping)"
msgstr ""
"può essere un numero intero tra 0 e 65535 o un intervallo con inizio e fine "
"nello stesso intervallo. Il formato dell'intervallo è <inizio>-<fine>. Usa "
"-1 per tutte le porte. Imposta il sottoprocollo se il protocollo è ICMP (8 "
"per il ping)."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1092
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1245
msgid ""
"rule destination. Syntax <type>:<value>. Destination type can be SG, CIDR. "
"For SG value must be <sg_id>. For CIDR value should like ###.###.###.###/24."
msgstr ""
"destinazione della regola. Sintassi <tipo>:<valore>. Il tipo di destinazione "
"può essere SG, CIDR. Per SG il valore deve essere <sg_id>. Per CIDR il "
"valore dovrebbe essere simile a ###.###.###.###/24."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1104
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1257
msgid ""
"rule source. Syntax <type>:<value>. Source type can be SG, CIDR. For SG "
"value must be <sg_id>. For CIDR value should like ###.###.###.###/24."
msgstr ""
"sorgente della regola. Sintassi <tipo>:<valore>. Il tipo di origine può "
"essere SG, CIDR. Per SG il valore deve essere <sg_id>. Per CIDR il valore "
"dovrebbe essere simile a ###.###.###.###/24."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1116
#: ../beehive3_cli/plugins/provider/controllers/resource.py:3569
msgid "orchestrators comma separated"
msgstr "orchestratori separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1197
msgid "delete a security group rule"
msgstr "elimina una regola del gruppo di sicurezza"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1198
msgid ""
"Delete a security group rule. This requires specifying the rule type (egress "
"or ingress), the security group id, and optionally the source/destination, "
"protocol and port details of the rule to delete."
msgstr ""
"Elimina una regola di security group. Questo richiede di specificare il tipo "
"di regola (egress o ingress), l'ID del security group e, opzionalmente, i "
"dettagli di origine/destinazione, protocollo e porta della regola da "
"eliminare."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1332
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1333
msgid "gateways service management"
msgstr "gestione dei servizi gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1336
msgid "get gateway templates"
msgstr "ottieni i template del gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1337
msgid ""
"This command is used to retrieve gateway templates from Nivola Cloud. "
"Gateway templates define the configuration of internet gateways that can be "
"attached to VPC networks to provide internet access to instances. By calling "
"this command without any arguments, it will return a list of all available "
"gateway templates that can be used when creating new internet gateways."
msgstr ""
"Questo comando è usato per recuperare i template di gateway da Nivola Cloud. "
"I template di gateway definiscono la configurazione dei gateway internet che "
"possono essere collegati alle reti VPC per fornire accesso a internet alle "
"istanze. Eseguendo questo comando senza argomenti, restituirà un elenco di "
"tutti i template di gateway disponibili che possono essere usati quando si "
"creano nuovi gateway internet."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1371
msgid "create a gateway"
msgstr "crea un gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1372
msgid ""
"This command creates a new internet gateway for the specified account using "
"the provided template id. The account id and template id are required "
"arguments that must be provided to create the gateway using the specified "
"template configuration."
msgstr ""
"Questo comando crea un nuovo gateway internet per l'account specificato "
"utilizzando l'ID del template fornito. L'ID dell'account e l'ID del template "
"sono argomenti obbligatori che devono essere forniti per creare il gateway "
"utilizzando la configurazione del template specificata."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1403
msgid "get gateways"
msgstr "ottieni i gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1404
msgid ""
"This command is used to retrieve a list of all internet gateways associated "
"with the current account. An internet gateway is a horizontally scaled, "
"redundant, and highly available VPC component that allows communication "
"between instances in your VPC and the Internet. It therefore provides a path "
"for internet-bound traffic to leave your VPC, and a path for internet-"
"sourced traffic to enter your VPC."
msgstr ""
"Questo comando è usato per recuperare un elenco di tutti i gateway internet "
"associati all'account corrente. Un gateway internet è un componente VPC "
"scalabile orizzontalmente, ridondante e altamente disponibile che consente "
"la comunicazione tra le istanze nella tua VPC e Internet. Fornisce quindi un "
"percorso per il traffico diretto a Internet per uscire dalla tua VPC e un "
"percorso per il traffico proveniente da Internet per entrare nella tua VPC."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1426
msgid "list of gateway id comma separated"
msgstr "elenco id del gateway separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1521
msgid "get gateway"
msgstr "ottieni gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1522
msgid ""
"This command retrieves information about an existing internet gateway in the "
"specified business unit. The gateway ID is required to identify the specific "
"gateway to retrieve details for."
msgstr ""
"Questo comando recupera informazioni su un gateway internet esistente "
"nell'unità di business specificata. L'ID del gateway è obbligatorio per "
"identificare il gateway specifico di cui recuperare i dettagli."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1529
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1569
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1590
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1615
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1640
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1665
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1692
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1718
#: ../beehive3_cli/plugins/provider/controllers/resource.py:9472
#: ../beehive3_cli/plugins/provider/controllers/resource.py:9732
#: ../beehive3_cli/plugins/provider/controllers/resource.py:9756
#: ../beehive3_cli/plugins/provider/controllers/resource.py:9789
#: ../beehive3_cli/plugins/provider/controllers/resource.py:9903
#: ../beehive3_cli/plugins/provider/controllers/resource.py:10014
#: ../beehive3_cli/plugins/provider/controllers/resource.py:10138
msgid "gateway id"
msgstr "id del gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1560
msgid "patch a gateway"
msgstr "esegui patch sul Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1561
msgid ""
"This command patches or updates a gateway. It requires the gateway ID as the "
"only required argument to identify which gateway to update. The gateway "
"fields can then be modified as needed through additional arguments or "
"options and committed with this command."
msgstr ""
"Questo comando esegue una patch o aggiorna un gateway. Richiede l'ID del "
"gateway come unico argomento obbligatorio per identificare quale gateway "
"aggiornare. I campi del gateway possono quindi essere modificati secondo "
"necessità tramite argomenti o opzioni aggiuntivi e applicati con questo "
"comando."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1582
msgid "delete a gateway"
msgstr "elimina un gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1583
msgid ""
"This command deletes an internet gateway from your account. You need to "
"provide the ID of the gateway you want to delete as the only required "
"argument 'gateway'."
msgstr ""
"Questo comando elimina un gateway Internet dal tuo account. È necessario "
"fornire l'ID del gateway che si desidera eliminare come unica argomentazione "
"richiesta \"gateway\"."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1606
msgid "attach vpc from gateway"
msgstr "attacca VPC a un Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1607
msgid ""
"This command attaches a VPC to an internet gateway. It requires the gateway "
"ID and VPC ID as arguments to specify which gateway and VPC to attach. "
"Attaching a VPC to an internet gateway enables access to the internet for "
"instances in the VPC."
msgstr ""
"Questo comando collega una VPC a un gateway internet. Richiede l'ID del "
"gateway e l'ID della VPC come argomenti per specificare quale gateway e VPC "
"collegare. Collegare una VPC a un gateway internet abilita l'accesso a "
"internet per le istanze nella VPC."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1630
msgid "detach vpc from gateway"
msgstr "scollega un VPC da un Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1631
msgid ""
"This command detaches a VPC from an internet gateway. It requires the "
"gateway ID and VPC ID as arguments to identify which gateway and VPC to "
"detach. Detaching a VPC from its internet gateway will remove the public "
"internet access to resources in the VPC like EC2 instances."
msgstr ""
"Questo comando scollega una VPC da un gateway internet. Richiede l'ID del "
"gateway e l'ID della VPC come argomenti per identificare quale gateway e VPC "
"scollegare. Scollegare una VPC dal suo gateway internet rimuoverà l'accesso "
"pubblico a internet per le risorse nella VPC, come le istanze EC2."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1655
msgid "get gateway bastion"
msgstr "ottieni i bastioni del gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1656
msgid ""
"This command retrieves the bastion details of an internet gateway. The "
"gateway id is required to identify the specific gateway to retrieve the "
"bastion details from. The gateway id can be found using the internet-"
"gateways list command."
msgstr ""
"Questo comando recupera i dettagli del bastione di un gateway internet. L'ID "
"del gateway è obbligatorio per identificare il gateway specifico da cui "
"recuperare i dettagli del bastione. L'ID del gateway può essere trovato "
"usando il comando internet-gateways list."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1682
msgid "create a gateway bastion"
msgstr "crea un bastione per il gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1683
msgid ""
"This command creates a bastion host for the specified internet gateway. A "
"bastion host allows secure inbound access to private subnets from the public "
"internet and helps manage and maintain resources within private subnets."
msgstr ""
"Questo comando crea un bastione per il gateway internet specificato. Un "
"bastione consente l'accesso in entrata sicuro a subnet private dall'internet "
"pubblico e aiuta a gestire e mantenere le risorse all'interno delle subnet "
"private."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1709
msgid "delete a gateway bastion"
msgstr "elimina un bastione del gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1710
msgid ""
"This command deletes a bastion host associated with an internet gateway. It "
"requires the gateway id as the only required argument to identify the "
"gateway and bastion host to delete."
msgstr ""
"Questo comando elimina un bastione associato a un gateway internet. Richiede "
"l'ID del gateway come unico argomento obbligatorio per identificare il "
"gateway e il bastione da eliminare."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1740
#: ../beehive3_cli/plugins/business/controllers/netaas.py:1741
msgid "health monitor service management"
msgstr "gestione dei servizi health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1747
msgid "get health monitor templates"
msgstr "ottieni i template degli health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1748
msgid ""
"This command is used to retrieve all the available health monitor templates "
"that can be used to configure health monitors for load balancers. Health "
"monitors are used to check the health status of backend servers in a load "
"balancer pool. Templates define common configurations that can be selected "
"while creating new health monitors. This command lists all the predefined "
"templates without any parameters."
msgstr ""
"Questo comando è usato per recuperare tutti i template di health monitor "
"disponibili che possono essere usati per configurare gli health monitor per "
"i load balancer. Gli health monitor sono usati per controllare lo stato di "
"salute dei server back end in un pool di load balancer. I template "
"definiscono configurazioni comuni che possono essere selezionate durante la "
"creazione di nuovi health monitor. Questo comando elenca tutti i template "
"predefiniti senza alcun parametro."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1782
msgid "list health monitors"
msgstr "elenca health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1783
msgid ""
"This command is used to list all the configured health monitors in the "
"Nivola CMP Bu Netaas platform. Health monitors are used to check the health "
"and availability of backend servers, load balancers, applications etc. This "
"command will display the name, type, delay, timeout and other configuration "
"details of all the existing health monitors."
msgstr ""
"Questo comando è usato per elencare tutti gli health monitor configurati "
"nella piattaforma Nivola CMP Bu Netaas. Gli health monitor sono usati per "
"controllare lo stato e la disponibilità dei server back-end, dei load "
"balancer, delle applicazioni ecc. Questo comando visualizzerà il nome, il "
"tipo, il ritardo, il timeout e altri dettagli di configurazione di tutti gli "
"health monitor esistenti."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1795
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2225
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2836
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3300
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4368
msgid "list of comma separated account ids"
msgstr "elenco degli ID account separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1804
msgid "list of comma separated health monitor ids"
msgstr "elenco degli ID health monitor separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1813
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2243
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2854
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3318
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4386
msgid "list of comma separated tags"
msgstr "elenco tag separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1909
msgid "get health monitor"
msgstr "ottieni health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1910
msgid ""
"This command is used to retrieve details of a specific health monitor "
"configured in Nivola Cloud. It requires the unique identifier or name of the "
"health monitor as an argument. The details returned include configuration "
"parameters like type of health check, interval, timeout etc. This helps to "
"view the configuration of any existing health monitor to check/troubleshoot "
"its working."
msgstr ""
"Questo comando è usato per recuperare i dettagli di uno specifico health "
"monitor configurato in Nivola Cloud. Richiede l'identificatore univoco o il "
"nome dell'health monitor come argomento. I dettagli restituiti includono "
"parametri di configurazione come il tipo di health check, l'intervallo, il "
"timeout ecc. Questo aiuta a visualizzare la configurazione di qualsiasi "
"health monitor esistente per verificarne o risolverne il funzionamento."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1918
msgid "health monitor uuid or name"
msgstr "uuid o nome dell'health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1939
msgid "create health monitor"
msgstr "crea health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1940
msgid ""
"This command is used to create a new health monitor. It requires the monitor "
"name, parent account id, protocol used to perform targets health check, "
"health monitor description, interval in seconds in which a server is to be "
"tested, maximum time in seconds in which a response from the server must be "
"received, maximum number of times the server is tested before it is declared "
"down, method to send the health check request to the server, url to get or "
"post, and expected string as required arguments."
msgstr ""
"Questo comando è usato per creare un nuovo health monitor. Richiede come "
"argomenti obbligatori il nome del monitor, l'ID dell'account padre, il "
"protocollo usato per eseguire l'health check dei target, la descrizione "
"dell'health monitor, l'intervallo in secondi in cui un server deve essere "
"testato, il tempo massimo in secondi entro cui una risposta dal server deve "
"essere ricevuta, il numero massimo di volte in cui il server viene testato "
"prima che venga dichiarato non disponibile, il metodo per inviare la "
"richiesta di health check al server, l'URL per ottenere o inviare (get o "
"post), e la stringa attesa."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1951
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:7769
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:7819
msgid "monitor name"
msgstr "nome del monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1960
msgid "protocol used to perform targets health check: {protocols}"
msgstr ""
"protocollo da usare per eseguire l'health check dei target: {protocols}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1971
msgid "health monitor description"
msgstr "descrizione dell'health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1979
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2068
msgid "interval in seconds in which a server is to be tested"
msgstr "intervallo in secondi in cui un server deve essere testato"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1987
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2076
msgid ""
"maximum time in seconds in which a response from the server must be received"
msgstr ""
"tempo massimo in secondi in cui deve essere ricevuta una risposta dal server"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:1995
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2084
msgid "maximum number of times the server is tested before it is declared down"
msgstr ""
"numero massimo di volte in cui il server viene testato prima che venga "
"dichiarato non disponibile"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2004
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2093
msgid "method to send the health check request to the server: {methods}"
msgstr "metodo della request dell'health check da inviare al server: {methods}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2014
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2103
msgid "URL to GET or POST"
msgstr "URL della GET o POST"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2018
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2107
msgid "expected string"
msgstr "stringa prevista"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2055
msgid "update health monitor"
msgstr "aggiorna health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2056
msgid ""
"This command updates an existing health monitor on Nivola Cloud. It requires "
"the health monitor ID and allows updating the interval, timeout, max "
"retries, method, url and expected values of the health monitor through the "
"required arguments."
msgstr ""
"Questo comando aggiorna un health monitor esistente su Nivola Cloud. "
"Richiede l'ID dell'health monitor e permette di aggiornarne l'intervallo, il "
"timeout, il numero massimo di tentativi, il metodo, l'URL e i valori attesi "
"tramite gli argomenti obbligatori."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2064
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2701
msgid "health monitor id"
msgstr "id dell'health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2137
msgid "delete health monitors"
msgstr "elimina health monitor"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2138
msgid ""
"This command deletes health monitors from the configured BEEHIVE instance. "
"The 'ids' argument requires a comma separated list of the IDs of the health "
"monitors to delete as input. Upon successful deletion, no output is returned."
msgstr ""
"Questo comando elimina gli health monitor dall'istanza BEEHIVE configurata. "
"L'argomento 'ids' richiede come input un elenco di ID degli health monitor "
"da eliminare, separati da virgola. In caso di eliminazione riuscita, non "
"viene restituito alcun output."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2149
msgid "comma separated health monitor ids"
msgstr "id di health monitor separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2170
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2171
msgid "target group service management"
msgstr "gestione dei servizi target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2177
msgid "get target group templates"
msgstr "ottieni i template dei target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2178
msgid ""
"This command is used to retrieve target group templates from Nivola Cloud. "
"Target group templates define the configuration for target groups, which are "
"used to route and load balance traffic in Nivola Cloud. This command will "
"return the available target group templates that can be used when creating a "
"new target group."
msgstr ""
"Questo comando è usato per recuperare i template di target group da Nivola "
"Cloud. I template di target group definiscono la configurazione per i target "
"group, che sono usati per instradare e bilanciare il carico del traffico in "
"Nivola Cloud. Questo comando restituirà i template di target group "
"disponibili che possono essere usati quando si crea un nuovo target group."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2212
msgid "list target groups"
msgstr "elenca target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2213
msgid ""
"This command is used to list all the target groups configured for the "
"beehive application. Target groups in AWS refer to groups of targets "
"(instances) that route traffic in an Application Load Balancer. This command "
"will retrieve and display the names of all target groups associated with the "
"specified beehive application."
msgstr ""
"Questo comando è usato per elencare tutti i target group configurati per "
"l'applicazione beehive. I target group in AWS si riferiscono a gruppi di "
"target (istanze) che instradano il traffico in un Application Load Balancer. "
"Questo comando recupererà e visualizzerà i nomi di tutti i target group "
"associati all'applicazione beehive specificata."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2234
msgid "list of comma separated target group ids"
msgstr "elenco degli ID del gruppo target separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2331
msgid "get target group"
msgstr "ottieni il target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2332
msgid ""
"This command is used to retrieve information about a specific target group "
"configured in Nivola CMP. The target group is identified either by its UUID "
"or name. The 'id' argument is required and should contain the target group "
"identifier to fetch details for a particular target group."
msgstr ""
"Questo comando aggiunge un target group a Nivola CMP. Un target group "
"contiene una collezione di target (VM o container) che possono ricevere "
"traffico dagli Elastic Load Balancers. Richiede la specificazione del nome "
"del target group, dell'ID dell'account padre, dell'algoritmo di "
"bilanciamento del carico, del tipo di target e, opzionalmente, una "
"descrizione e l'ID dell'health monitor."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2340
msgid "target group uuid or name"
msgstr "uuid o nome del target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2417
msgid "create empty target group"
msgstr "crea un target group vuoto"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2418
msgid ""
"This command adds a target group to Nivola CMP. A target group contains a "
"collection of targets (VMs or containers) that can receive traffic from "
"Elastic Load Balancers. It requires specifying the target group name, parent "
"account ID, load balancing algorithm, target type, and optionally a "
"description and health monitor ID."
msgstr ""
"Questo comando aggiunge un target group a Nivola CMP. Un target group "
"contiene una collezione di target (VM o container) che possono ricevere "
"traffico dagli Elastic Load Balancers. Richiede la specificazione del nome "
"del target group, dell'ID dell'account padre, dell'algoritmo di "
"bilanciamento del carico, del tipo di target e, opzionalmente, una "
"descrizione e l'ID dell'health monitor."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2430
msgid "target group name"
msgstr "nome del target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2440
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2529
msgid "algorithm used to load balance targets: {balancing_algorithms}"
msgstr ""
"algoritmo utilizzato per bilanciare il carico dei target: "
"{balancing_algorithms}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2452
msgid "target type: {target_types}"
msgstr "tipi di target: {target_types}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2461
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2520
msgid "target group description"
msgstr "descrizione del target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2469
msgid "id of the custom monitor to perform health checks on targets"
msgstr "id del custom monitor per eseguire l'health check sui target"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2478
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2541
msgid ""
"whether client IP addresses are visible to the backend servers, {[True, "
"False]}"
msgstr ""
"se gli indirizzi IP dei client sono visibili ai server back-end,  {[True, "
"False]}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2506
msgid "update target group"
msgstr "aggiorna target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2507
msgid ""
"This command updates a target group in Nivola CMP. The required arguments "
"are the target group id to update (-id), the new target group description (-"
"desc) and the load balancing algorithm (-balancing_algorithm) to use among "
"the target group targets."
msgstr ""
"Questo comando aggiorna un target group in Nivola CMP. Gli argomenti "
"obbligatori sono l'ID del target group da aggiornare (-id), la nuova "
"descrizione del target group (-desc) e l'algoritmo di bilanciamento del "
"carico (-balancing_algorithm) da usare tra i target del target group."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2516
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2604
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2656
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2698
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2726
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3522
msgid "target group id"
msgstr "id del target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2569
msgid "delete target groups"
msgstr "elimina target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2570
msgid ""
"This command deletes target groups from the Nivola CMP platform. The 'ids' "
"argument is required and expects a comma separated list of target group IDs "
"to delete."
msgstr ""
"Questo comando elimina i target group dalla piattaforma Nivola CMP. "
"L'argomento 'ids' è obbligatorio e si aspetta un elenco di ID di target "
"group separati da virgole da eliminare."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2580
msgid "comma separated target group ids"
msgstr "id di target group separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2596
msgid "register targets with target group"
msgstr "registra un target a un target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2597
msgid ""
"This command registers targets with a target group. It requires the target "
"group id and a comma separated list of target identifiers and port mappings "
"in the format <target_id>:<lb_port> or <target_id>:<target_port>:<hm_port>."
msgstr ""
"Questo comando registra i target con un target group. Richiede l'ID del "
"target group e un elenco di identificatori di target separati da virgola e "
"mappature di porta nel formato <target_id>:<lb_port> o <target_id>:"
"<target_port>:<hm_port>."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2608
msgid ""
"comma separated list of couples <target_id>:<lb_port> or triplets "
"<target_id>:<target_port>:<hm_port>"
msgstr ""
"elenco separato da virgola di coppie <orscher_id>: <LB_PORT> o triplette "
"<Inget_id>: <Target_Port>: <hm_port>"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2648
msgid "deregister targets from target group"
msgstr "de registra un target dal target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2649
msgid ""
"This command deregisters targets from a target group. It requires the target "
"group id and a comma separated list of target ids as arguments. The targets "
"will be removed from load balancing of the target group."
msgstr ""
"Questo comando de registra target da un gruppo target. Richiede l'ID del "
"gruppo target e un elenco separato della virgola di ID target come "
"argomenti. Gli obiettivi verranno rimossi dal bilanciamento del carico del "
"gruppo target."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2660
msgid "comma separated list of target ids"
msgstr "elenco di id di target separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2690
msgid "register health monitor with target group"
msgstr "registra l'health monitor dal target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2691
msgid ""
"This command registers a health monitor with a target group. It requires the "
"target group id and health monitor id as required arguments to associate the "
"health check with the target group."
msgstr ""
"Questo comando registra un health monitor con un target group. Richiede l'ID "
"del target group e l'ID dell'health monitor come argomenti obbligatori per "
"associare l'health check al target group."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2720
msgid "deregister health monitor from target group"
msgstr "de registra l'health monitor dal target group"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2721
msgid ""
"This command deregisters a health monitor from a target group. It requires "
"the target group ID as the only argument to identify which target group's "
"health monitor will be deregistered."
msgstr ""
"Questo comando annulla la registrazione di un health monitor da un target "
"group. Richiede l'ID del target group come unico argomento per identificare "
"l'health monitor di quale target group verrà annullato."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2741
#: ../beehive3_cli/plugins/business/controllers/netaas.py:2742
msgid "listener service management"
msgstr "gestione dei servizi listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2786
msgid "get listener templates"
msgstr "ottieni template dei listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2787
msgid ""
"This command is used to retrieve listener templates configured in Nivola "
"Cloud. Listener templates define the frontend configuration for load "
"balancers and application delivery controllers in Nivola Cloud. The command "
"does not require any arguments as it will return all available listener "
"templates by default. These templates can then be selected when creating a "
"new listener on a load balancer or ADC to simplify configuration of common "
"scenarios like HTTP, HTTPS or TCP load balancing."
msgstr ""
"Questo comando è usato per recuperare tutti i template di load balancer "
"disponibili da Nivola Cloud. I template di load balancer definiscono la "
"configurazione per i load balancer che possono essere creati. Questo comando "
"elenca le opzioni disponibili senza creare alcuna risorsa."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2823
msgid "list listeners"
msgstr "elenco listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2824
msgid ""
"This command lists all the configured listeners for the Nivola CMP "
"application running on Nivola Cloud. Listeners allow incoming connections "
"from external clients or services and are configured during application "
"deployment to expose specific ports. This command displays the listener "
"name, port and protocol of each active listener without any other output."
msgstr ""
"Questo comando elenca tutti i listener configurati per l'applicazione Nivola "
"CMP in esecuzione su Nivola Cloud. I listener consentono connessioni in "
"entrata da client o servizi esterni e vengono configurati durante il "
"deployment dell'applicazione per esporre porte specifiche. Questo comando "
"visualizza il nome del listener, la porta e il protocollo di ogni listener "
"attivo senza alcun altro output."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2845
msgid "list of comma separated listener ids"
msgstr "elenco di id di listener separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2940
msgid "get listener"
msgstr "ottieni listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2941
msgid ""
"This command is used to retrieve information about a specific listener "
"configured on the Nivola CMP platform. It requires the unique identifier or "
"name of the listener as the only required argument. The listener details "
"will be displayed upon running this command with a valid listener id or name."
msgstr ""
"Questo comando è usato per recuperare informazioni su un listener specifico "
"configurato sulla piattaforma Nivola CMP. Richiede l'identificatore univoco "
"o il nome del listener come unico argomento obbligatorio. I dettagli del "
"listener verranno visualizzati dopo l'esecuzione di questo comando con un ID "
"o nome del listener valido."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2949
msgid "listener uuid or name"
msgstr "uuid o nome del listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2970
msgid "create listener"
msgstr "crea listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2971
msgid ""
"This command creates a new listener on a Nivola CMP load balancer. It "
"requires specifying the listener name, parent account ID, traffic type (TCP, "
"HTTP, etc.), and optionally can configure settings like persistence, "
"certificates, ciphers, headers and redirections."
msgstr ""
"Questo comando crea un nuovo listener su un load balancer Nivola CMP. "
"Richiede la specificazione del nome del listener, dell'ID dell'account "
"padre, del tipo di traffico (TCP, HTTP, ecc.) e opzionalmente può "
"configurare impostazioni come la persistenza, i certificati, le cifrature, "
"le intestazioni e i re-indirizzamenti."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2979
msgid "listener name"
msgstr "nome del listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2988
msgid "incoming traffic profile; one of: {traffic_types}"
msgstr "profilo per il traffico in entrata; uno tra: {traffic_types}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:2998
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3118
msgid "listener description"
msgstr "descrizione del listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3004
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3124
msgid "persistence type: {persistence_methods}"
msgstr "tipo di persistenza: {persistence_methods}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3014
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3135
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:7365
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:7577
msgid "cookie name"
msgstr "nome del cookie"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3020
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3144
msgid "cookie mode: {cookie_modes}"
msgstr "modalità del cookie: {cookie_modes}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3028
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3152
msgid "expire time in seconds"
msgstr "tempo di scadenza in secondi"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3032
msgid "client certificate path"
msgstr "percorso del certificato del cliente"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3036
msgid "server certificate path"
msgstr "percorso del certificato del server"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3042
msgid "cipher suite used by client; one of: "
msgstr "suite di cifratura utilizzata dal client; una tra: "

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3052
msgid "cipher suite used by server; one of: "
msgstr "suite di cifratura utilizzata dal server; una tra: "

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3062
msgid "insert X-Forwarded-For HTTP header"
msgstr "inserisci header HTTP X-Forwarded-For"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3070
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3167
msgid "url to redirect client requests"
msgstr "url dove reindirizzare le richieste dei client"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3105
msgid "update listener"
msgstr "aggiorna listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3106
msgid ""
"Update an existing load balancer listener configuration. The required "
"arguments are the listener id to update and at least one configuration "
"parameter like the description, persistence type, cookie settings etc. This "
"allows modifying listener settings non-disruptively."
msgstr ""
"Aggiorna la configurazione di un listener di load balancer esistente. Gli "
"argomenti obbligatori sono l'ID del listener da aggiornare e almeno un "
"parametro di configurazione come la descrizione, il tipo di persistenza, le "
"impostazioni dei cookie, ecc. Ciò consente di modificare le impostazioni del "
"listener senza interruzioni."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3115
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3519
msgid "listener id"
msgstr "id del listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3158
msgid "insert X-Forwarded-For HTTP header, ['True', 'False']"
msgstr "inserisci header HTTP X-Forwarded, ['True', 'False']"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3194
msgid "delete listeners"
msgstr "elimina un listener"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3195
msgid ""
"This command deletes one or more listeners from a beehive cluster. The ids "
"argument is required and expects a comma separated list of listener ids to "
"delete from the cluster configured with the beehive CLI. Once deleted, the "
"listeners will no longer accept or proxy requests."
msgstr ""
"Questo comando elimina uno o più listener da un cluster beehive. L'argomento "
"'ids' è obbligatorio e si aspetta un elenco di ID listener separati da "
"virgole da eliminare dal cluster configurato con la CLI beehive. Una volta "
"eliminati, i listener non accetteranno o proxyeranno più richieste."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3206
msgid "comma separated listener ids"
msgstr "id dei listener, separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3247
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3248
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4178
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4179
msgid "load balancer service management"
msgstr "gestione dei servizi di load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3254
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4214
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4242
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4284
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4310
msgid "get load balancer templates"
msgstr "ottieni i template dei load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3255
msgid ""
"This command is used to retrieve all the available load balancer templates "
"from Nivola Cloud. Load balancer templates define the configuration for load "
"balancers that can be created. This command lists the available options "
"without creating any resources."
msgstr ""
"Questo comando è usato per recuperare tutti i modelli di load balancer "
"disponibili da Nivola Cloud. I modelli di bilanciamento definiscono la "
"configurazione per i load balancer che possono essere creati. Questo comando "
"elenca le opzioni disponibili senza creare alcuna risorsa."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3287
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4355
msgid "list load balancers"
msgstr "elenca load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3288
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4356
msgid ""
"This command lists all the load balancers in the accounts specified or in "
"the default account if no account is specified. Load balancers are "
"networking components that distribute incoming application traffic across "
"multiple backend servers."
msgstr ""
"Questo comando elenca tutti i load balancer negli account specificati o "
"nell'account predefinito se non viene specificato alcun account. I load "
"balancer sono componenti di rete che distribuiscono il traffico applicativo "
"in entrata su più server back-end."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3309
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4377
msgid "list of comma separated load balancer ids"
msgstr "elenco di id di load balancer separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3410
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4476
msgid "get load balancer"
msgstr "ottieni load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3411
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4477
msgid ""
"This command is used to retrieve information about a specific load balancer "
"configured in Nivola Cloud. It requires the unique identifier (UUID) or name "
"of the load balancer as the only required argument. The command will return "
"details like the load balancer type, port, protocol, backend servers and "
"health check configuration."
msgstr ""
"Questo comando è usato per recuperare informazioni su uno specifico load "
"balancer configurato in Nivola Cloud. Richiede l'identificatore univoco "
"(UUID) o il nome del load balancer come unico argomento obbligatorio. Il "
"comando restituirà dettagli come il tipo di load balancer, la porta, il "
"protocollo, i server back-end e la configurazione del health check."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3419
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4485
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4525
msgid "load balancer uuid or name"
msgstr "uuid o nome del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3488
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3489
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4565
msgid "create load balancer"
msgstr "crea un load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3494
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4571
#: ../beehive3_cli/plugins/provider/controllers/resource.py:10253
msgid "load balancer name"
msgstr "nome del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3503
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4588
msgid "load balancer service definition"
msgstr "service definition del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3512
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3624
msgid "protocol for connections to load balancer: {protocols}"
msgstr ""
"protocollo da utilizzare per la connessione al load balancer: {protocols}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3518
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3630
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:8169
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:8266
msgid "port number"
msgstr "numero di porta"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3527
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3615
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4604
msgid "load balancer description"
msgstr "descrizione del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3535
msgid "load balancer frontend ip address"
msgstr "indirizzo IP del front-end del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3543
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3634
#: ../beehive3_cli/plugins/vsphere/controllers/platform.py:8187
msgid "maximum concurrent connections"
msgstr "connessioni concomitanti massime"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3552
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3642
msgid "maximum connections per second"
msgstr "numero di connessioni massimo per secondo"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3561
msgid "project deployment environment: {deployment_envs}"
msgstr "ambiente di deployment del progetto: {deployment_envs}"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3603
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4668
msgid "update load balancer"
msgstr "aggiorna load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3604
msgid ""
"This CLI command updates a load balancer on Nivola Cloud. It requires the "
"load balancer ID and allows updating the description, protocol, port number, "
"maximum concurrent connections, and maximum connections per second."
msgstr ""
"Questo comando CLI aggiorna un load balancer su Nivola Cloud. Richiede l'ID "
"del bilanciatore del carico e consente di aggiornare la descrizione, il "
"protocollo, il numero di porta, le connessioni simultanee massime e le "
"connessioni massime al secondo."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3673
#: ../beehive3_cli/plugins/business/controllers/netaas.py:4729
msgid ""
"This command deletes a load balancer from Nivola Cloud. It requires the ID "
"of the load balancer to delete as a required argument. The load balancer ID "
"uniquely identifies the load balancer instance."
msgstr ""
"Questo comando elimina un load balancer da Nivola Cloud. Richiede all'ID del "
"bilanciatore da eliminare come argomento richiesto. L'id del bilanciatore "
"identifica in modo univoco l'istanza del bilanciatore del carico."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3696
msgid "enable load balancer"
msgstr "abilita load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3697
msgid ""
"This command enables a load balancer that was previously created. It "
"requires the ID of the load balancer to start as a required argument. The "
"load balancer ID uniquely identifies the load balancer instance. Enabling "
"the load balancer allows it to start distributing traffic to the backend "
"servers."
msgstr ""
"Questo comando abilita un load balancer che era stato precedentemente "
"creato. Richiede che l'ID del bilanciatore del carico inizi come argomento "
"richiesto. L'id del load balancer identifica in modo univoco l'istanza del "
"bilanciatore del carico. Abilitare il bilanciamento del carico gli consente "
"di iniziare a distribuire il traffico ai server back -end."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3718
msgid "disable load balancer"
msgstr "disabilita load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3719
msgid ""
"This command stops or disables the specified load balancer. It takes the "
"load balancer ID as the only required argument. Disabling a load balancer "
"will stop forwarding traffic to the backend servers and the health check "
"will stop. The load balancer can be re-enabled using the 'beehive bu netaas "
"load-balancers start' command."
msgstr ""
"Questo comando arresta o disabilita il load balancer specificato. Prende "
"l'ID del bilanciatore come unica argomento richiesto. La disabilitazione di "
"un load balancer smetterà di inoltrare il traffico verso i server back -end "
"e il controllo della salute si fermerà. Il bilanciamento del carico può "
"essere riabilitato utilizzando il comando 'beehive bu netaas load-balancers "
"start'."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3741
msgid "delete load balancer generic services"
msgstr "elimina i servizi generici del load balancer"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3742
msgid ""
"This command deletes predefined load balancer services for a given account "
"id. The account id argument is required to identify the account whose "
"predefined services need to be deleted from the load balancer. Deleting "
"predefined services removes the preconfigured load balancing rules for "
"applications like HTTP, HTTPS etc for the specified account."
msgstr ""
"Questo comando elimina i servizi di load balancing predefinito per un "
"determinato ID account. L'argomento ID account è richiesto per identificare "
"l'account i cui servizi predefiniti devono essere eliminati dal "
"bilanciamento del carico. La cancellazione dei servizi predefiniti rimuove "
"le regole di bilanciamento del carico preconfigurate per applicazioni come "
"HTTP, HTTPS ecc. Per l'account specificato."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3794
#: ../beehive3_cli/plugins/business/controllers/netaas.py:3795
msgid "ssh gateway service management"
msgstr "gestione dei servizi SSH Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3798
msgid "get ssh gateway configurations"
msgstr "ottieni configurazioni SSH Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3799
msgid ""
"This command is used to retrieve the list of configured SSH gateway "
"configurations on the Nivola CMP platform. SSH gateways allow clients to "
"connect to internal resources through a secure tunnel without exposing those "
"resources directly to the internet. The conf-list subcommand displays all "
"existing SSH gateway configurations by name so they can be easily identified "
"and referred to by other commands."
msgstr ""
"Questo comando viene utilizzato per recuperare l'elenco delle configurazioni "
"di gateway SSH configurate sulla piattaforma Nivola CMP. I gateway SSH "
"consentono ai clienti di connettersi alle risorse interne attraverso un "
"tunnel sicuro senza esporre tali risorse direttamente a Internet. Il sotto "
"comando conf-list visualizza tutte le configurazioni del gateway SSH "
"esistenti per nome in modo che possano essere facilmente identificati e "
"indicati da altri comandi."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3821
msgid "list of ssh gateway configurations id comma separated"
msgstr "elenco id delle configurazioni del gateway SSH separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3830
msgid "list of ssh gateway configurations names comma separated"
msgstr "elenco dei nomi configurazioni del gateway SSH separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3918
msgid "get ssh gateway configuration"
msgstr "ottieni la configurazione SSH Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3919
msgid ""
"This command is used to retrieve the configuration of a specific SSH gateway "
"from the Nivola CMP platform. The 'id' argument is required and should "
"contain the unique identifier of the SSH gateway configuration to fetch. "
"This command will return the full configuration details of the specified SSH "
"gateway as a JSON object."
msgstr ""
"Questo comando viene utilizzato per recuperare la configurazione di un "
"gateway SSH specifico dalla piattaforma Nivola CMP. L'argomento \"ID\" è "
"richiesto e dovrebbe contenere l'identificatore univoco della configurazione "
"del gateway SSH da recuperare. Questo comando restituirà i dettagli completi "
"di configurazione del gateway SSH specificato come oggetto JSON."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3931
msgid "ssh gateway configuration id"
msgstr "id della configurazione del gateway SSH"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3959
msgid "add ssh gateway configuration"
msgstr "aggiungi la configurazione del gateway SSH"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3960
msgid ""
"This CLI command is used to add SSH gateway configuration to a beehive "
"device. The conf-add subcommand of the beehive bu netaas sshgw command "
"allows administrators to configure SSH tunnels and gateways on Cisco SD-WAN "
"devices for site-to-site or client VPN access. No arguments are required for "
"this command as the configuration values can be passed interactively. The "
"command connects to the designated device and prompts for inputs to define "
"the SSH gateway settings that should be added."
msgstr ""
"Questo comando CLI viene utilizzato per aggiungere la configurazione del "
"gateway SSH a un dispositivo Beehive. Il sotto comando conf-add del comando "
"Beehive BU Netaas SSHGW consente agli amministratori di configurare tunnel "
"SSH e gateway sui dispositivi Cisco SD-WAN per l'accesso al sito a sito o al "
"client VPN. Non sono richiesti argomenti per questo comando poiché i valori "
"di configurazione possono essere passati in modo interattivo. Il comando si "
"collega al dispositivo designato e chiede gli ingressi per definire le "
"impostazioni del gateway SSH che dovrebbero essere aggiunte."

#: ../beehive3_cli/plugins/business/controllers/netaas.py:3975
#: ../beehive3_cli/plugins/sshgateway/controllers/resource.py:127
msgid "configuration name"
msgstr "nome della configurazione"

