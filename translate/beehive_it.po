msgstr "tag del link"

#: ../beehive3_cli/plugins/business/controllers/service.py:1964
msgid "add service link"
msgstr "aggiungi un service link"

#: ../beehive3_cli/plugins/business/controllers/service.py:1965
msgid ""
"This command adds a service link between two services by specifying the "
"required arguments - service link name, account id, start service uuid and "
"end service uuid. A service link defines the relationship between two "
"services in an account and allows them to communicate with each other."
msgstr ""
"Questo comando aggiunge un service link tra due servizi specificando gli "
"argomenti obbligatori - nome del service link, ID account, UUID del servizio "
"iniziale e UUID del servizio finale. Un service link definisce la relazione "
"tra due servizi in un account e consente loro di comunicare tra loro."

#: ../beehive3_cli/plugins/business/controllers/service.py:1976
#: ../beehive3_cli/plugins/business/controllers/service.py:2044
