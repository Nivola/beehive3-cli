#: ../beehive3_cli/plugins/business/controllers/cpaas.py:840
#: ../beehive3_cli/plugins/business/controllers/cpaas.py:1087
msgid "List virtual machine"
msgstr "Elenca le macchine virtuali"

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:841
#: ../beehive3_cli/plugins/business/controllers/cpaas.py:1088
msgid ""
"This command lists the virtual machines under the specified account. No "
"arguments are required. The -accounts flag can be used to filter the VMs by "
"a specific account. The -e <env> filters VMs by environment like pod, region "
"etc."
msgstr ""
"Questo comando elenca le macchine virtuali sotto l'account specificato. Non "
"sono richiesti argomenti. Il flag -accounts può essere utilizzato per "
"filtrare le VM in base a un account specifico. L'opzione -e <env> filtra le "
"VM per ambiente come pod, regione ecc."

#: ../beehive3_cli/plugins/business/controllers/cpaas.py:863
#: ../beehive3_cli/plugins/business/controllers/cpaas.py:1110
msgid "list of vm id comma separated"
msgstr "elenco degli id delle VM separate da virgola"

