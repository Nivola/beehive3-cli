#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:410
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:443
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:472
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:505
msgid "service catalog id"
msgstr "id del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:56
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:121
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:163
msgid "service catalog name"
msgstr "nome del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:111
msgid "add service catalog"
msgstr "aggiungi service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:112
msgid ""
"This CLI command is used to add a new service catalog to the Nivola CMP "
"platform. The 'name' argument is required and is used to specify the name of "
"the service catalog being added."
msgstr ""
"Questo comando CLI viene utilizzato per aggiungere un nuovo service catalog "
"alla piattaforma Nivola CMP. L'argomento 'name' è richiesto e viene "
"utilizzato per specificare il nome del catalogo di servizi aggiunto."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:126
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:172
msgid "service catalog description"
msgstr "descrizione del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:147
msgid "update service catalog"
msgstr "aggiorna il service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:148
msgid ""
"This command updates an existing service catalog in Nivola CMP. It requires "
"the ID of the service catalog to update as the only required argument. The "
"ID is used to identify and retrieve the existing service catalog object from "
"the database to then apply the update changes to and save it back."
msgstr ""
"Questo comando aggiorna un service catalog esistente in Nivola CMP. Richiede "
"l'ID del service catalog da aggiornare come unico argomento obbligatorio. "
"L'ID viene utilizzato per identificare e recuperare l'oggetto service "
"catalog esistente dal database per poi applicare le modifiche di "
"aggiornamento e salvarlo nuovamente."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:190
msgid "refresh service catalog"
msgstr "aggiorna il service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:191
msgid ""
"This CLI command patches or refreshes an existing service catalog in Nivola "
"CMP. It requires the service catalog ID as a required argument to identify "
"which catalog needs to be refreshed. Refreshing a catalog updates it with "
"any changes to the available services, plans or metadata from the upstream "
"catalog provider."
msgstr ""
"Questo comando CLI applica patch o aggiorna un service catalog esistente in "
"Nivola CMP. Richiede l'ID del service catalog come argomento obbligatorio "
"per identificare quale catalogo deve essere aggiornato. L'aggiornamento di "
"un catalogo lo sincronizza con eventuali modifiche ai servizi disponibili, a "
"piani o ai metadati dal provider di catalogo a monte."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:215
msgid "delete service catalog"
msgstr "elimina un service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:216
msgid ""
"This command deletes a service catalog from Nivola CMP. It requires the id "
"of the service catalog to delete as a required argument. The id uniquely "
"identifies the service catalog that is to be removed from the system."
msgstr ""
"Questo comando elimina un service catalog da Nivola CMP. Richiede cl'ID del "
"service catalog da eliminare come argomento richiesto. L'ID identifica in "
"modo univoco il service catalog che deve essere rimosso dal sistema."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:236
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:269
msgid "delete service catalog service definition"
msgstr "elimina la service definition del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:237
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:270
msgid ""
"This command adds service definitions to a service catalog. It requires the "
"service catalog id and a comma separated list of definition ids to add to "
"the catalog. This allows adding multiple preexisting definitions to a "
"catalog in one command."
msgstr ""
"Questo comando aggiunge service definition a un service catalog. Richiede "
"l'ID del service catalog e un elenco di ID di service definition separati da "
"virgole da aggiungere al catalogo. Ciò consente di aggiungere più service "
"definition preesistenti a un catalogo in un unico comando."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:252
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:285
msgid "comma separated list of definition id"
msgstr "elenco separato da virgola di ID service definition"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:307
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:308
msgid "service catalog authorization"
msgstr "autorizzazione del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:311
msgid "get service catalog  roles"
msgstr "ottieni ruoli del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:312
msgid ""
"This command gets the roles associated with a service catalog. It requires "
"the service catalog id as the only required argument to identify the catalog "
"and retrieve its roles."
msgstr ""
"Questo comando ottiene i ruoli associati a un service catalog. Vuole come "
"unico argomento l'ID del service catalog per identificare il catalogo e "
"recuperare i suoi ruoli."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:333
msgid "get service catalog  users"
msgstr "ottieni utenti del catalogo di servizi"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:334
msgid ""
"This command retrieves information about a specific user belonging to a "
"service catalog. It requires the ID of the service catalog as a required "
"argument to identify which catalog's users are being accessed. The command "
"outputs details about the requested user, including their name, email and "
"role within the specified service catalog."
msgstr ""
"Questo comando recupera informazioni su un utente specifico appartenente a "
"un service catalog. Richiede l'ID del service catalog come argomento "
"obbligatorio per identificare gli utenti del catalogo a cui si accede. Il "
"comando mostra i dettagli sull'utente richiesto, incluso il proprio nome, "
"email e ruolo all'interno del catalogo di servizi specificato."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:363
msgid "add service catalog  role to a user"
msgstr "aggiungi il ruolo del service catalog a un utente"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:364
msgid ""
"This command adds a user to a service catalog role. It requires the service "
"catalog id, role and user name as arguments to identify the service catalog, "
"role and user respectively to add the authorization. This allows assigning "
"access control permissions to users for service catalogs."
msgstr ""
"Questo comando aggiunge un utente a un ruolo del service catalog. Richiede "
"l'ID del service catalog, il ruolo e il nome utente come argomenti per "
"identificare rispettivamente il catalogo dei servizi, il ruolo e l'utente a "
"cui aggiungere l'autorizzazione.Ciò consente di assegnare agli utenti "
"autorizzazioni di controllo degli accessi per i service catalog."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:379
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:414
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:476
#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:509
msgid "service catalog role"
msgstr "ruolo del service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:398
msgid "remove service catalog  role from a user"
msgstr "rimuovi il ruolo del service catalog da un utente"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:399
msgid ""
"This command removes a user's authorization for a specific role from a "
"service catalog. The service catalog is identified by its ID, the role is "
"specified, and the user to remove authorization for is provided. This allows "
"managing what users have access to perform certain operations on a given "
"service catalog."
msgstr ""
"Questo comando rimuove l'autorizzazione di un utente per un ruolo specifico "
"dal service catalog. Il service catalog è identificato dal suo ID, viene "
"specificato il ruolo e viene fornito l'utente per rimuovere "
"l'autorizzazione. Questo consente di gestire gli accessi degli utenti per "
"eseguire determinate operazioni su un determinato service catalog."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:433
msgid "get service catalog  groups"
msgstr "ottieni gruppi di service catalog"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:434
msgid ""
"This command retrieves the groups associated with a specific service "
"catalog. It requires the service catalog ID as the only required argument to "
"identify the catalog. The groups returned would be those that have access to "
"the resources provisioned by that catalog."
msgstr ""
"Questo comando recupera i gruppi associati a un catalogo di servizi "
"specifico. Richiede l'ID del service catalog come unico obbligatorio "
"richiesto per identificare il catalogo.I gruppi restituiti dovrebbero essere "
"quelli che hanno accesso alle risorse fornite da quel catalogo."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:461
msgid "add service catalog  role to a group"
msgstr "aggiungi il ruolo del service catalog a un gruppo"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:462
msgid ""
"This command adds an authorization group to a service catalog role. The "
"required arguments are the service catalog id, the role within the catalog "
"(e.g. viewer or editor), and the name of the authorization group to add to "
"that role."
msgstr ""
"Questo comando aggiunge un gruppo di autorizzazione a un ruolo di service "
"catalog. Gli argomenti richiesti sono l'ID del service catalog, il ruolo "
"all'interno del catalogo (ad es. viewer o editor) e il nome del gruppo di "
"autorizzazione da aggiungere a quel ruolo."

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:495
msgid "remove service catalog  role from a group"
msgstr "rimuovi il ruolo del catalogo di servizio da un gruppo"

#: ../beehive3_cli/plugins/business/controllers/authority/catalog.py:496
msgid ""
"This command removes a service catalog role from an authorization group. It "
"requires the service catalog ID, role and group name as arguments to "
"identify which role assignment to remove."
msgstr ""
"Questo comando rimuove un ruolo del service catalog da un gruppo di "
"autorizzazione. Richiede l'ID del service catalog, il ruolo e il nome del "
"gruppo come argomenti per identificare quale assegnazione di ruolo rimuovere."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:14
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:15
msgid "division management"
msgstr "gestione della divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:41
msgid "get divisions"
msgstr "ottieni divisioni"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:42
msgid ""
"This command is used to retrieve all the configured divisions or a specific "
"division based on name or id from the Nivola CMP platform. Divisions in "
"Nivola CMP are logical groupings of environments like Dev, Test, Staging etc "
"that can be used for authorization and access control purposes."
msgstr ""
"Questo comando viene utilizzato per recuperare tutte le divisioni "
"configurate o una divisione specifica in base al nome o all'ID dalla "
"piattaforma Nivola CMP. Le divisioni in Nivola CMP sono raggruppamenti "
"logici di ambienti come Dev, Test, Staging ecc. Che possono essere "
"utilizzati per scopi di autorizzazione e controllo degli accessi."

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:72
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:173
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:250
