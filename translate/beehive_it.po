#: ../beehive3_cli/plugins/business/controllers/netaas.py:4120
msgid "ssh gateway conf id"
msgstr "id della configurazione SSH Gateway"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:4110
msgid "activate ssh gw configuration"
msgstr "attiva la configurazione SSH GW"

#: ../beehive3_cli/plugins/business/controllers/netaas.py:4111
msgid ""
"This command activates an existing SSH gateway configuration on Nivola "
"Cloud. It requires the SSH gateway configuration ID and destination port "
"number as required arguments to identify and activate the specific "
"configuration."
msgstr ""
"Questo comando attiva una configurazione SSH Gateway esistente su Nivola "
"Cloud. Richiede l'ID di configurazione del gateway SSH e il numero di porta "
"di destinazione come argomenti richiesti per identificare e attivare la "
"configurazione specifica."

