msgid "division contact"
msgstr "contatto di divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:99
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:199
#: ../beehive3_cli/plugins/business/controllers/authority/division.py:281
msgid "division email"
msgstr "email di divisione"

#: ../beehive3_cli/plugins/business/controllers/authority/division.py:108
