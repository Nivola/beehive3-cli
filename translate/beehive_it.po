msgstr "id dello job schedule"

#: ../beehive3_cli/plugins/business/controllers/service.py:2847
msgid "job schedule type"
msgstr "tipo dello job schedule"

#: ../beehive3_cli/plugins/business/controllers/service.py:2856
msgid "job schedule metric type"
msgstr "tipo di metrica job schedule"

