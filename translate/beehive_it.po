msgstr "attributi del service link"

#: ../beehive3_cli/plugins/business/controllers/service.py:2033
msgid "update service link"
msgstr "aggiorna service link"

#: ../beehive3_cli/plugins/business/controllers/service.py:2034
msgid ""
"This command updates an existing service link. It requires the service link "
"uuid as the id argument to identify which service link to update."
msgstr ""
"Questo comando aggiorna un service link esistente. Richiede l'UUID del "
"service link come argomento id per identificare quale service link "
"aggiornare."

#: ../beehive3_cli/plugins/business/controllers/service.py:2040
msgid "service link uuid"
msgstr "uuid di service link"

#: ../beehive3_cli/plugins/business/controllers/service.py:2105
msgid "delete service links"
msgstr "elimina service link"

#: ../beehive3_cli/plugins/business/controllers/service.py:2106
msgid ""
"This command deletes service links by their UUIDs. The 'ids' argument "
"requires a comma separated list of service link UUIDs to delete as input. "
"This allows deleting multiple service links with a single command."
msgstr ""
"Questo comando elimina i service link tramite i loro UUID. L'argomento 'ids' "
"richiede come input un elenco di UUID dei service link da eliminare, "
"separati da virgole. Ciò consente di eliminare più service link con un "
"singolo comando."

