#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1741
msgid "delete a db instance"
msgstr "elimina un'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1742
msgid ""
"This command deletes a db instance from the Nivola CMP Database as a Service "
"(DBaaS). It requires the database instance id as the only required argument "
"to identify the instance to delete."
msgstr ""
"Questo comando elimina un'istanza DB dal Database as a Service (DBaaS) di "
"Nivola CMP. Richiede l'ID dell'istanza del database come unico argomento "
"obbligatorio per identificare l'istanza da eliminare."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1770
msgid "start a db instance"
msgstr "avvia un'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1771
msgid ""
"This command starts a db instance that was previously stopped or created. "
"The required database argument specifies the id of the db instance to start. "
"Starting a db instance provisions the underlying infrastructure and makes "
"the database available."
msgstr ""
"Questo comando avvia un'istanza DB che era stata precedentemente arrestata o "
"creata. L'argomento database obbligatorio specifica l'ID dell'istanza DB da "
"avviare. L'avvio di un'istanza DB esegue il provisioning dell'infrastruttura "
"sottostante e rende disponibile il database."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1794
msgid "stop a db instance"
msgstr "ferma un'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1795
msgid ""
"This command stops a database instance by its id. The required database "
"argument specifies the id of the db instance to stop."
msgstr ""
"Questo comando arresta un'istanza di database tramite il suo ID. L'argomento "
"database obbligatorio specifica l'ID dell'istanza del DB da arrestare."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1817
msgid "reboot a db instance"
msgstr "riavvia un'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1818
msgid ""
"This command reboots a database instance in the Nivola CMP Database as a "
"Service (DBaaS). The required 'database' argument specifies the unique "
"identifier of the database instance to reboot. Rebooting a database instance "
"will restart the underlying database server, causing a brief interruption of "
"service during the reboot process."
msgstr ""
"Questo comando riavvia un'istanza di database nel Database as a Service "
"(DBaaS) di Nivola CMP. L'argomento database obbligatorio specifica "
"l'identificatore univoco dell'istanza di database da riavviare. Il riavvio "
"di un'istanza di database riavvierà il server di database sottostante, "
"causando una breve interruzione del servizio durante il processo di riavvio."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1845
msgid "get db instance databases/schemas"
msgstr "ottieni database/schemi dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1846
msgid ""
"This command gets the databases/schemas of a given db instance. It requires "
"the db instance id as the only required argument."
msgstr ""
"Questo comando ottiene i database/schemi di una data istanza DB. Richiede "
"l'ID dell'istanza DB come unico argomento obbligatorio."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1885
msgid "create a db instance database/schema"
msgstr "crea un database/schema dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1886
msgid ""
"This command creates a database/schema within a db instance on the Nivola "
"CMP DBaaS platform. It requires the db instance id, database name and "
"charset as required arguments to uniquely identify and create the new "
"database."
msgstr ""
"Questo comando crea un database/schema all'interno di un'istanza DB sulla "
"piattaforma Nivola CMP DBaaS. Richiede l'ID dell'istanza DB, il nome del "
"database e il set di caratteri come argomenti obbligatori per identificare e "
"creare in modo univoco il nuovo database."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1897
#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1930
#: ../beehive3_cli/plugins/platforms/controllers/mariadb.py:572
#: ../beehive3_cli/plugins/platforms/controllers/mariadb.py:608
msgid "database name"
msgstr "nome del database"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1900
msgid "database charset"
msgstr "charset del database"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1918
msgid "delete a db instance database/schema"
msgstr "elimina un database/schema dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1919
msgid ""
"This command deletes a database/schema from a Db instance. It requires the "
"Db instance id and the name of the database to delete as required arguments."
msgstr ""
"Questo comando elimina un database/schema da un'istanza Db. Richiede come "
"argomenti obbligatori l'ID dell'istanza Db e il nome del database da "
"eliminare."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1949
msgid "get db instance users"
msgstr "ottieni utenti di istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1950
msgid ""
"This command gets the users for a specific database instance. The 'instance' "
"argument is required and specifies the ID of the database instance to "
"retrieve users for."
msgstr ""
"Questo comando ottiene gli utenti per una specifica istanza di database. "
"L'argomento 'instance' è obbligatorio e specifica l'ID dell'istanza di "
"database per la quale recuperare gli utenti."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1975
msgid "create a db instance user"
msgstr "crea un utente di istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:1976
msgid ""
"This command creates a database instance user. It requires the database "
"instance id, the user name and the user password as required arguments to "
"add a new user to the specified database instance."
msgstr ""
"Questo comando crea un utente per un'istanza di database. Richiede l'ID "
"dell'istanza del database, il nome utente e la password utente come "
"argomenti obbligatori per aggiungere un nuovo utente all'istanza di database "
"specificata."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2005
msgid "delete a db instance user"
msgstr "elimina un utente dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2006
msgid ""
"This command deletes a database instance user. It requires the database "
"instance id and the name of the user to delete as required arguments. The "
"instance id identifies the database the user belongs to and the name "
"specifies which user to delete from that instance."
msgstr ""
"Questo comando elimina un utente di un'istanza di database. Richiede come "
"argomenti obbligatori l'ID dell'istanza di database e il nome dell'utente da "
"eliminare. L'ID dell'istanza identifica il database a cui appartiene "
"l'utente e il nome specifica quale utente eliminare da quell'istanza."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2023
msgid "force deletion"
msgstr "forza l'eliminazione"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2045
msgid "grant db instance user privileges"
msgstr "concedi i privilegi dell'utente dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2046
msgid ""
"This command grants privileges to a database user on a specific database "
"instance and database. The required arguments are the instance ID, user name "
"and database name to grant privileges to."
msgstr ""
"Questo comando concede i privilegi a un utente di database su una specifica "
"istanza di database e su un database. Gli argomenti richiesti sono l'ID "
"dell'istanza, il nome utente e il nome del database a cui concedere i "
"privilegi."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2061
#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2119
msgid ""
"database name. For postgres use db1 to select a database e db1.schema1 to "
"select schema schema1 in database db1"
msgstr ""
"nome del database. Per PostgreSQL usa DB1 per selezionare un database E "
"db1.schema1 per selezionare Schema Schema1 nel database DB1"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2072
#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2130
msgid ""
"privileges admitted: mysql - SELECT,INSERT,DELETE,UPDATE,ALL, postgres db - "
"CONNECT, postgres schema - USAGE,CREATE,ALL"
msgstr ""
"privilegi ammessi: MySQL: SELECT, INSERT, DELETE, UPDATE, ALL PostgreSQL "
"(database): CONNECT PostgreSQL (schema): USAGE, CREATE, ALL"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2103
msgid "revoke db instance user privileges"
msgstr "revoca i privilegi dell'utente dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2104
msgid ""
"This command revokes privileges of a database user on a specific database "
"instance. The required arguments are the instance id, user name and database "
"name to identify the user and database uniquely and revoke the privileges."
msgstr ""
"Questo comando revoca i privilegi di un utente di database su una specifica "
"istanza di database. Gli argomenti obbligatori sono l'ID dell'istanza, il "
"nome utente e il nome del database per identificare in modo univoco l'utente."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2163
msgid "change db instance user password"
msgstr "modifica la password utente dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2164
msgid ""
"This command changes the password for a database user in a specific database "
"instance. It requires the instance id, username and new password as "
"arguments to identify the user and update the password."
msgstr ""
"Questo comando modifica la password per un utente di database in una "
"specifica istanza di database. Richiede l'ID dell'istanza, il nome utente e "
"la nuova password come argomenti per identificare l'utente e aggiornare la "
"password."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2193
msgid "enable db instance monitoring"
msgstr "abilita il monitoraggio dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2194
msgid ""
"This command enables monitoring on a specific database instance. The "
"required 'instance' argument specifies the ID of the database instance to "
"enable monitoring on. Monitoring collects metrics on database performance "
"and resource usage to help with troubleshooting and capacity planning."
msgstr ""
"Questo comando abilita il monitoraggio su una specifica istanza di database. "
"L'argomento instance obbligatorio specifica l'ID dell'istanza di database su "
"cui abilitare il monitoraggio. Il monitoraggio raccoglie metriche sulle "
"prestazioni del database e sull'utilizzo delle risorse per aiutare nella "
"risoluzione dei problemi e nella pianificazione della capacità."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2229
msgid "disable db instance monitoring"
msgstr "disabilita il monitoraggio dell'istanza DB"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2230
msgid ""
"This command disables monitoring for the specified database instance. "
"Monitoring collects metrics about your database instance's performance and "
"availability and makes this available in the Nivola CMP console. Disabling "
"monitoring stops collecting these metrics but can improve performance for "
"low usage instances."
msgstr ""
"Questo comando disabilita il monitoraggio per l'istanza di database "
"specificata. Il monitoraggio raccoglie metriche sulle prestazioni e la "
"disponibilità dell'istanza del tuo database e le rende disponibili nella "
"console di Nivola CMP. Disabilitare il monitoraggio interrompe la raccolta "
"di queste metriche ma può migliorare le prestazioni per le istanze a basso "
"utilizzo."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2255
msgid "enable db instance logging"
msgstr "abilita il logging dell'istanza del database"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2256
msgid ""
"This command enables logging for the specified database instance. The "
"'instance' argument is required and specifies the ID of the virtual machine "
"instance for which logging needs to be enabled. Enabling logging allows "
"monitoring and troubleshooting of database operations and queries."
msgstr ""
"Questo comando abilita il logging per l'istanza di database specificata. "
"L'argomento 'instance' è obbligatorio e specifica l'ID dell'istanza della "
"macchina virtuale per la quale è necessario abilitare il logging. "
"L'abilitazione del logging consente il monitoraggio e la risoluzione dei "
"problemi relativi alle operazioni e alle query del database."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2300
msgid "import a dbaas"
msgstr "importa un DBAAS"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2301
msgid ""
"This command imports the dbaas vm into a specified container. It requires "
"the container ID, VM name, physical VM ID from the provider,  provider image "
"ID, and VM password as required arguments."
msgstr "Questo comando importa il dbaas."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2312
msgid "container id where import virtual machine. e.g. Podto1Vsphere"
msgstr ""
"id del contenitore in cui importa la macchina virtuale. per esempio.  "
"Podto1Vsphere"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2319
msgid "dbaas name. e.g. dbs-01p"
msgstr "nome del dbaas. per esempio. DBS-01p"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2324
msgid "physical id of the dbaas virtual machine to import"
msgstr "id fisico della macchina virtuale DBAAS da importare"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2332
msgid "associated virtual machine password"
msgstr "password della macchina virtuale associata"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2340
msgid "name of the vm image of the dbaas. e.g. Postegresql-14.7-vs"
msgstr "nome dell'immagine VM del DBaaS. Es. Postegresql-14.7-vs"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2347
#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2469
msgid "dbaas engine"
msgstr "engine del dbaas"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2351
#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2473
msgid "dbaas engine version"
msgstr "versione dell'Engine DBAAS"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2454
msgid "dev: import a dbaas from vm"
msgstr "dev: importa un dbaas da una VM"

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2455
msgid "This command imports a standarad vm created on Nivola as a dbaas."
msgstr ""
"Questo comando importa una VM standard creata su Nivola come un  dbaas."

#: ../beehive3_cli/plugins/business/controllers/dbaas.py:2462
msgid "cpaas vm uuid"
msgstr "uuid della VM CPaaS"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:19
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:20
msgid "container service management"
msgstr "gestione dei servizi Container"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:23
msgid "get container service info"
msgstr "ottieni informazioni sul container"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:24
msgid ""
"This command retrieves information about the container service for the "
"specified account. The 'account' argument is required and specifies the "
"account ID to get container info for."
msgstr ""
"Questo comando recupera informazioni sui servizi ecaas per l'account "
"specificato. L'argomento 'account' è obbligatorio e specifica l'ID "
"dell'account per il quale ottenere le informazioni."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:48
msgid "get container service quotas"
msgstr "ottieni le quote dei servizi container"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:49
msgid ""
"This command gets the container service quotas for a given account id. The "
"account id is a required argument for this command to retrieve the quotas "
"allocated to that account."
msgstr ""
"Questo comando ottiene le quote ecaas per un dato ID account. L'ID account è "
"un argomento obbligatorio per questo comando per recuperare le quote "
"allocate."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:82
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:83
msgid "container namespace service management"
msgstr "gestione dei namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:88
msgid "list container namespaces"
msgstr "lista di namespaces"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:89
msgid ""
"This command lists all the container namespaces configured in the Nivola CMP "
"ecaas account specified. Namespaces are used to logically group container "
"objects like servers, services etc. No arguments are required for this "
"command to just display the namespace names."
msgstr ""
"Questo comando elenca tutti i namespaces configurati nell'account Nivola "
"CMP. I namespace sono usati per raggruppare logicamente oggetti come servizi "
"k8s ecc. Non sono necessari parametri per visualizzare i nomi dei Namespaces."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:109
msgid "list of container instances id comma separated"
msgstr "elenco di id di istanze separate da virgola"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:221
msgid "get container namespace"
msgstr "restituisce il namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:222
msgid ""
"This command retrieves information about a specific container namespace. The "
"namespace is identified by its unique id which must be provided as an "
"required argument."
msgstr ""
"Questo comando recupera informazioni su uno specifico namespace ecaas. Il "
"namespace è identificato dal  suo ID univoco che deve essere fornito come "
"argomento obbligatorio."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:229
msgid "namespace id"
msgstr "id del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:255
msgid "create a container namespace"
msgstr "crea un Namespace ecaas"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:256
msgid ""
"This command creates a container namespace. It requires the parent account "
"id as an argument to add the namespace under."
msgstr ""
"Questo comando crea un namespace ecaas . Richiede l'ID dell'account in cui "
"creare il servizio ."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:270
msgid "cluster name rancher"
msgstr "cluster name presente su Rancher"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:278
msgid "codice ente"
msgstr "codice dell'ente"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:282
msgid "codice prodotto"
msgstr "codice del prodotto"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:286
msgid "environment"
msgstr "ambiente"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:290
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:437
msgid "email pm"
msgstr "email del pm"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:295
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:442
msgid "limit cpu"
msgstr ""
"limite CPU es: 200m (indica come valore 200 millicpu) - 2 (indica come "
"valore 2CPU)"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:299
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:446
msgid "limit memory"
msgstr ""
"limite memoria es: 2Gi (indica come valore 2 Giga) - 2Mi (indica come valore "
"per 2 Mega)"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:303
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:450
msgid "limit storage"
msgstr ""
"limite spazio disco sul namespace es: 2Gi (indica come valore 2 Giga Byte) "
"0Gi (nel caso non sia necessario spazio nel namespace)"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:308
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:455
msgid "backup policy"
msgstr "policy di  backup del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:313
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:460
msgid "allowedHosts"
msgstr ""
"lista degli host su cui attivare le regole di network, '-' per campo vuoto "
"(',' come separatore)"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:317
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:464
msgid "allowedCIDR"
msgstr ""
"lista network da abilitare tramite regole cilium, '-' per campo vuoto (',' "
"come separatore) es: - 10.102.102.0/24 abilita sotto-rete - 10.102.102.10/32 "
"abilita host"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:321
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:468
msgid "allowedHostPatterns"
msgstr ""
"lista degli host pattern da abilitare, '-' per campo vuoto (',' come "
"separatore) es: *.csi.it, *.nivolapiemonte.it"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:325
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:472
msgid "networkPolicyActive"
msgstr "network policy active: true/false"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:330
#: ../beehive3_cli/plugins/business/controllers/ecaas.py:477
msgid "norescreate_namespace"
msgstr "non crea/modifica il namespace su Git"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:419
msgid "update a container namespace"
msgstr "aggiorna namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:420
msgid "This command updates a container namespace."
msgstr "Questo comando aggiorna un namespace ecaas."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:429
msgid "namespace oid"
msgstr "oid (o nome) del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:552
msgid "delete a container namespace"
msgstr "elimina il Namespace ecaas"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:553
msgid ""
"Delete a container namespace by providing the container namespace id as an "
"argument. This will remove the namespace and all child objects like "
"dashboards, alerts etc within that namespace permanently."
msgstr ""
"Cancella il namespace  attraverso il suo  id . Questo comando rimuove "
"permanentemente il namespace a tutti gli oggetti contenuti quali dashboards, "
"alerts etc ."

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:563
msgid "container namespace id"
msgstr "identificativo del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:568
msgid "noresdelete_namespace"
msgstr ""
"se True non cancella il namespace su Git quindi non cancella il namespace da "
"Rancher (viene solo cancellato il servizio nella CMP)"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:614
msgid "get namespace clusters"
msgstr "ottieni il cluster del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:615
msgid "This command is used to get namespace clusters"
msgstr "Questo comando serve per recuperare il cluster di un namespace ecaas"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:645
msgid "get namespace environments"
msgstr "ottieni ambienti del namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:646
msgid "This command is used to get namespace environments"
msgstr "Questo comando serve per recuperare l'ambiente dei namespace"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:676
msgid "get namespace backup policies"
msgstr "ottieni le policy di backup"

#: ../beehive3_cli/plugins/business/controllers/ecaas.py:677
msgid "This command is used to get namespace backup policies"
msgstr ""
"Questo comando serve per recuperare le policy di backup di un namespace"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:17
#: ../beehive3_cli/plugins/business/controllers/logaas.py:18
msgid "logging service management"
msgstr "gestione dei servizi di logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:21
msgid "get logging service info"
msgstr "ottieni informazioni sui servizi di logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:22
msgid ""
"This command retrieves information about the logging service for the "
"specified account. The required 'account' argument should provide the "
"account ID to get the logging service info for."
msgstr ""
"Questo comando recupera informazioni sui servizi di logging per l'account "
"specificato. L'argomento account obbligatorio dovrebbe fornire l'ID "
"dell'account per il quale ottenere le informazioni del servizio di logging."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:47
msgid "get logging service quotas"
msgstr "ottieni le quote dei servizi di logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:48
msgid ""
"This command gets the logging service quotas for a specific account. The "
"account id is required to retrieve the quotas allocated to that account."
msgstr ""
"Questo comando ottiene le quote dei servizi di logging per un account "
"specifico. L'ID dell'account è richiesto per recuperare le quote allocate a "
"quell'account."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:79
#: ../beehive3_cli/plugins/business/controllers/logaas.py:80
msgid "logging instance service management"
msgstr "gestione dei servizi logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:85
msgid "get logging module configs"
msgstr "ottieni le configurazioni del modulo di logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:86
msgid ""
"This command is used to retrieve the logging module configurations for all "
"instances or a specific instance. The logging module configs contain "
"information like log levels, destinations etc that are used by the logging "
"service. No arguments are required to get configs for all instances. If an "
"instance name is provided, it will return configs only for that particular "
"instance."
msgstr ""
"Questo comando è usato per recuperare le configurazioni dei moduli di "
"logging per tutte le istanze o per una specifica istanza. Le configurazioni "
"dei moduli di logging contengono informazioni come i livelli di log, le "
"destinazioni, ecc., che sono usate dai servizi di logging. Nessun argomento "
"è richiesto per ottenere le configurazioni per tutte le istanze. Se viene "
"fornito un nome di istanza, restituirà le configurazioni solo per quella "
"particolare istanza."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:116
msgid "list logging instances"
msgstr "elenca le logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:117
msgid ""
"This command lists all the logging instances in the current account or "
"provided accounts. Logging instances are used to aggregate and store logs "
"from applications and services. The list provides details like instance ID, "
"name, status and other metadata for each logging instance."
msgstr ""
"Questo comando elenca tutte le logging instance nell'account corrente o "
"negli account forniti. Le logging instance sono usate per aggregare e "
"archiviare i log da applicazioni e servizi. L'elenco fornisce dettagli come "
"l'ID dell'istanza, il nome, lo stato e altri metadati per ogni logging "
"instance."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:137
msgid "logging instances name"
msgstr "nome della logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:173
msgid "detail show in list"
msgstr "mostra i dettagli nell'elenco"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:245
msgid "get logging instance"
msgstr "ottieni logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:246
msgid ""
"This command retrieves details of a specific logging instance. The required "
"'id' argument specifies the unique identifier of the logging instance to "
"fetch details for."
msgstr ""
"Questo comando recupera i dettagli di una specifica logging instance. "
"L'argomento id obbligatorio specifica l'identificatore univoco della logging "
"instance di cui recuperare i dettagli."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:256
#: ../beehive3_cli/plugins/business/controllers/logaas.py:364
#: ../beehive3_cli/plugins/business/controllers/logaas.py:392
#: ../beehive3_cli/plugins/business/controllers/logaas.py:426
msgid "logging instance id"
msgstr "id della logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:288
msgid "create a logging instance"
msgstr "crea una logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:289
msgid ""
"This CLI command creates a logging instance by adding it. It requires the "
"parent account id and instance id as arguments to identify the account and "
"instance to add. This allows administrators to provision new logging "
"instances under accounts in the Nivola CMP platform."
msgstr ""
"Questo comando CLI crea una logging instance aggiungendola. Richiede l'ID "
"dell'account padre e l'ID dell'istanza come argomenti per identificare "
"l'account e l'istanza da aggiungere. Questo permette agli amministratori di "
"provisionare nuove logging instance sotto gli account nella piattaforma "
"Nivola CMP."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:303
#: ../beehive3_cli/plugins/business/controllers/maas.py:268
msgid "instance"
msgstr "istanza"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:307
#: ../beehive3_cli/plugins/business/controllers/maas.py:272
msgid "definition"
msgstr "definizione"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:316
msgid "doesn't install agent on vm"
msgstr "non installa l'agente sulla VM"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:353
msgid "delete a logging instance"
msgstr "elimina logging instance"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:354
msgid ""
"This command deletes a logging instance by specifying its instance id. The "
"instance id identifies the logging instance that needs to be deleted from "
"the Nivola CMP logging service."
msgstr ""
"Questo comando elimina una logging instance specificandone l'ID. L'ID "
"dell'istanza identifica la logging instance che deve essere eliminata dal "
"servizio di logging di Nivola CMP."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:380
msgid "enable logging module"
msgstr "abilita modulo di logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:381
msgid ""
"This command enables a logging module on a specified logging instance. It "
"requires the instance ID and module configuration as arguments. The instance "
"ID identifies the logging instance to modify and the module configuration "
"specifies which module to enable, like 'apache'."
msgstr ""
"Questo comando abilita un modulo di logging su una specificata logging "
"instance. Richiede l'ID dell'istanza e la configurazione del modulo come "
"argomenti. L'ID dell'istanza identifica la logging instance da modificare e "
"la configurazione del modulo specifica quale modulo abilitare, come 'apache'."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:396
#: ../beehive3_cli/plugins/business/controllers/logaas.py:430
msgid "module configuration"
msgstr "configurazione del modulo"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:414
msgid "disable logging module"
msgstr "disabilita il modulo logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:415
msgid ""
"This command disables a logging module on a specified logging instance. It "
"requires the instance ID and module configuration as arguments. The instance "
"ID identifies the logging instance and the module configuration specifies "
"which module to disable, like 'apache'."
msgstr ""
"Questo comando disabilita un modulo di logging su una specificata logging "
"instance. Richiede l'ID dell'istanza e la configurazione del modulo come "
"argomenti. L'ID dell'istanza identifica la logging instance e la "
"configurazione del modulo specifica quale modulo disabilitare, come 'apache'."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:448
#: ../beehive3_cli/plugins/business/controllers/logaas.py:449
msgid "logging space service management"
msgstr "gestione dei servizi space del logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:454
msgid "list logging spaces"
msgstr "elenca logging space"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:455
msgid ""
"This command lists all the logging spaces configured in the current "
"environment. Logging spaces are logical containers that group log sources "
"together for centralized logging and monitoring. The list displays the name "
"and ID of each space."
msgstr ""
"Questo comando elenca tutti gli space di logging configurati nell'ambiente "
"corrente. Gli space di logging sono contenitori logici che raggruppano le "
"sorgenti di log per la registrazione e il monitoraggio centralizzati. "
"L'elenco visualizza il nome e l'ID di ogni space."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:475
msgid "list of logging instances id comma separated"
msgstr "elenco di id di istanze di logging separati da virgola"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:576
msgid "get logging space"
msgstr "ottieni lo space del logging"

#: ../beehive3_cli/plugins/business/controllers/logaas.py:577
msgid ""
"This command retrieves information about a specific logging space by its id. "
"The space id is required as an argument to identify the space to get details "
"for. Details returned include the space name, description, status and other "
"metadata."
msgstr ""
"Questo comando recupera informazioni su uno specifico space di logging "
"tramite il suo ID. L'ID dello space è richiesto come argomento per "
"identificare lo space di cui ottenere i dettagli. I dettagli restituiti "
"includono il nome dello space, la descrizione, lo stato e altri metadati."

#: ../beehive3_cli/plugins/business/controllers/logaas.py:585
#: ../beehive3_cli/plugins/kibana/controllers/platform.py:100
#: ../beehive3_cli/plugins/kibana/controllers/platform.py:172
