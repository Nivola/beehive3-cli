msgstr "uuid del sevizio di partenza"

#: ../beehive3_cli/plugins/business/controllers/service.py:1994
#: ../beehive3_cli/plugins/business/controllers/service.py:2071
msgid "end service uuid"
msgstr "uuid del sevizio di arrivo"

#: ../beehive3_cli/plugins/business/controllers/service.py:1999
#: ../beehive3_cli/plugins/business/controllers/service.py:2080
