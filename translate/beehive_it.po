msgstr "nome dello job schedule"

#: ../beehive3_cli/plugins/business/controllers/service.py:2829
msgid "job schedule job name"
msgstr "nome dello job schedule"

#: ../beehive3_cli/plugins/business/controllers/service.py:2838
