"aggiorna il contenitore della risorsa\n"
"            il file deve essere un json o yaml\n"
"            lo schema\n"
"            name = fields.String(default=\"test\")\n"
"            desc = fields.String(default=\"test\")\n"
"            active = fields.Boolean(default=True)\n"
"            conn = fields.Dict(default={})\n"
"            state = fields.Integer(default=0)\n"
"           tags = fields.Nested(UpdateResourceTagDescRequestSchema, "
"allow_none=True)\n"
"           dove\n"
"           class UpdateResourceTagDescRequestSchema(Schema):\n"
"           cmd = fields.String(default=\"add\", required=True)\n"
"           values = fields.List(fields.String(default=\"test\"), "
"required=True)\n"
"\n"
"        "

